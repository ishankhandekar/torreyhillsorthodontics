---
import Navbar from "./Navbar.astro";
import Ticker from "./Ticker.astro";

const consultation = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/consultation`;
---

<Navbar />

<div class="hero-frame">
  <section class="hero">
    <div class="hero-content">
      <h1>Expert Orthodontic Care in Torrey Hills</h1>
      {/* Dr. Lee's specialty is from her bio. Confirm the age range and that
          she is the only orthodontist here before launch — "herself" is the
          claim doing the work in this sentence. */}
      <p class="hero-copy">
        Braces, clear aligners and early treatment for children, teens and
        adults — every visit with Dr. Judy Lee herself.
      </p>
      <a href={consultation} class="hero-button">
        Schedule Your Free Consultation
        <svg class="hero-button-arrow" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M4 12 12 4M6 4h6v6"></path>
        </svg>
      </a>
    </div>

    {/* Sits at the foot of the photo rather than in its own band below it */}
    <Ticker />
  </section>
</div>
