---
import Logo from "./Logo.astro";
import Ticker from "./Ticker.astro";

const home = import.meta.env.BASE_URL;

const navLinks = [
  { href: "#about", label: "About" },
  { href: "#services", label: "Services" },
  { href: "#gallery", label: "Smile Gallery" },
  { href: "#faq", label: "FAQ" },
  { href: "#contact", label: "Contact Us" },
];
---

<header class="navbar">
  <Logo href={home} />

  <nav class="nav-links" id="nav-links">
    {navLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
  </nav>

  <div class="nav-actions">
    {/* Local practices lead with the phone; the number is the signal, so it
        is text rather than an icon until the navbar runs out of room */}
    <a href="tel:+18584811771" class="nav-phone">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"
        ></path>
      </svg>
      <span class="nav-phone-number">(858) 481-1771</span>
    </a>
    <a href="#" class="nav-icon" aria-label="Facebook">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M14 8V6.1c0-.85.2-1.3 1.5-1.3H17V1.5A22 22 0 0 0 14.8 1.4C11.9 1.4 10.3 3 10.3 6v2H7.5v3.5h2.8V22H14V11.5h2.8l.4-3.5z"
        ></path>
      </svg>
    </a>
    <a href="#contact" class="nav-button">Appointment</a>
  </div>

  <button
    class="nav-toggle"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="nav-links"
  >
    <span></span><span></span><span></span>
  </button>
</header>

<div class="hero-frame">
  <section class="hero">
    <div class="hero-content">
      <h1>Get the smile you’ve always wanted</h1>
      <a href="#contact" class="hero-button">
        Schedule Your Free Consultation
        <svg class="hero-button-arrow" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M4 12 12 4M6 4h6v6"></path>
        </svg>
      </a>
    </div>

    {/* Sits at the foot of the photo rather than in its own band below it */}
    <Ticker />
  </section>
</div>

<script>
  const navToggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const navLinks = document.querySelector<HTMLElement>(".nav-links");

  if (navToggle && navLinks) {
    const setMenu = (open: boolean) => {
      navLinks.classList.toggle("open", open);
      navToggle.setAttribute("aria-expanded", String(open));
      navToggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      // Lock the page behind the full-screen mobile menu
      document.body.style.overflow = open ? "hidden" : "";
    };

    navToggle.addEventListener("click", () => {
      setMenu(!navLinks.classList.contains("open"));
    });

    navLinks.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setMenu(false));
    });
  }
</script>
