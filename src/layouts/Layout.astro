---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Lora:wght@400&family=Jost:wght@400;500&family=Poppins:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  :root {
    /* Width of the white bezel around the hero */
    --frame: 14px;
    --ink: #16232c;
    /* Brand blue: 3.96:1 on white, so it is only AA-safe for large text
       (the section headings). Small text and white-on-blue fills use
       --blue-dark (5.06:1); hover states go to --blue-deep (5.81:1). */
    --blue: #2a86c4;
    --blue-dark: #2274ab;
    --blue-deep: #1f6a9e;
    --muted: #4a5a64;
    /* Tinted band behind the ticker */
    --band: #f7f9fa;
    /* Midnight navy, pitched near the hero's own dark wash so the two dark
       areas of the page read as the same colour family */
    --midnight: #0c2033;
    --hairline: rgba(22, 35, 44, 0.12);
    /* Frosted-glass surface shared by the nav pills and the menu toggle */
    --glass-bg: rgba(255, 255, 255, 0.16);
    --glass-border: rgba(255, 255, 255, 0.28);
    --glass-blur: blur(14px) saturate(140%);
    /* Navbar inner spacing (the scroll effect adds --frame on top of this) */
    --nav-pad-y: 20px;
    --nav-pad-x: 24px;
  }

  body {
    margin: 0;
    font-family: "Poppins", system-ui, sans-serif;
    background: #fff;
  }

  /* Navbar: sits inside the framed hero, with the links in floating white pills */
  .navbar {
    position: absolute;
    top: var(--frame);
    left: var(--frame);
    right: var(--frame);
    z-index: 10;
    /* Equal side columns keep the links truly centered on the page */
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: var(--nav-pad-y) var(--nav-pad-x);
  }

  .logo {
    justify-self: start;
    display: flex;
    align-items: center;
    gap: 12px;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
  }

  .logo-mark {
    width: 52px;
    height: auto;
    fill: #fff;
  }

  .logo-wire {
    fill: none;
    stroke: #fff;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    font-family: "Jost", "Poppins", sans-serif;
    line-height: 1;
  }

  .logo-top {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .logo-name {
    font-size: 1.55rem;
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  .nav-links {
    display: flex;
    gap: 2px;
    padding: 6px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border-radius: 999px;
  }

  .nav-links a {
    color: #fff;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    padding: 9px 16px;
    border-radius: 999px;
    transition: background 0.2s;
  }

  .nav-links a:hover {
    background: rgba(255, 255, 255, 0.18);
  }

  .nav-actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 6px 6px 6px 18px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border-radius: 999px;
  }

  .nav-icon {
    display: flex;
    color: #fff;
  }

  .nav-icon svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .nav-button {
    color: #fff;
    background: var(--ink);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    padding: 9px 20px;
    border-radius: 999px;
    transition: background 0.2s;
  }

  .nav-button:hover {
    background: var(--blue-dark);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border-radius: 50%;
    cursor: pointer;
  }

  .nav-toggle span {
    width: 18px;
    height: 2px;
    background: #fff;
    transition: transform 0.25s, opacity 0.25s;
  }

  /* Frosted bezel: a blurred, lightened copy of the photo shows around the card */
  .hero-frame {
    position: relative;
    padding: var(--frame);
    overflow: hidden;
  }

  .hero-frame::before,
  .hero-frame::after {
    content: "";
    position: absolute;
  }

  .hero-frame::before {
    /* Oversized so the blur doesn't fade to transparent at the edges */
    inset: -60px;
    background: url("/images/hero.jpg") 35% 30% / cover no-repeat;
    filter: blur(24px) saturate(140%);
  }

  .hero-frame::after {
    inset: 0;
    background: rgba(255, 255, 255, 0.3);
  }

  /* Hero: a rounded photo card inset inside the bezel */
  .hero {
    position: relative;
    z-index: 1;
    height: calc(100vh - 2 * var(--frame));
    height: calc(100svh - 2 * var(--frame));
    border-radius: 28px;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.35);
    overflow: hidden;
    background: url("/images/hero.jpg") 35% 30% / cover no-repeat;
    /* Content sits in the lower part of the photo so it never covers her smile */
    display: flex;
    align-items: flex-end;
    justify-content: center;
    text-align: center;
    padding: 0 24px 12vh;
  }

  /* Darkens the top of the photo so the white logo stays readable against the bright sky */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 220px;
    background: linear-gradient(rgba(0, 0, 0, 0.35), transparent);
  }

  /* Light wash over the whole photo so the white headline holds up on the bright sky */
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(rgba(10, 30, 45, 0.1) 40%, rgba(10, 30, 45, 0.45));
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 900px;
  }

  .hero h1 {
    margin: 0 0 40px;
    color: #fff;
    font-family: "DM Serif Display", Georgia, serif;
    font-weight: 400;
    font-size: clamp(2.6rem, 6.2vw, 5.75rem);
    line-height: 1.02;
    letter-spacing: 0.005em;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.25);
  }

  .hero-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--blue-dark);
    color: #fff;
    text-decoration: none;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 15px 28px;
    border-radius: 8px;
    transition: background 0.2s;
  }

  .hero-button:hover {
    background: var(--blue-deep);
  }

  .hero-button-arrow {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s;
  }

  .hero-button:hover .hero-button-arrow {
    transform: translateY(2px);
  }

  /* Certification ticker */
  .ticker {
    background: var(--band);
    padding: 46px 0 50px;
    overflow: hidden;
  }

  .ticker-label {
    margin: 0 0 30px;
    text-align: center;
    color: #5f6e78;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  /* Fades the logos out at both edges instead of clipping them hard */
  .ticker-viewport {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent,
      #000 7%,
      #000 93%,
      transparent
    );
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 7%,
      #000 93%,
      transparent
    );
  }

  .ticker-track {
    display: flex;
    width: max-content;
    animation: ticker-scroll 42s linear infinite;
  }

  .ticker-viewport:hover .ticker-track {
    animation-play-state: paused;
  }

  /* The trailing padding matches the gap so the two copies butt together
     with no visible seam at the loop point. */
  .ticker-group {
    display: flex;
    align-items: center;
    gap: 40px;
    margin: 0;
    padding: 0 40px 0 0;
    list-style: none;
  }

  .ticker-group li {
    display: flex;
  }

  /* Same soft pill on hover as the navbar links, inverted for the light band */
  .ticker-group a {
    /* 4.7:1 on the band — the muted logo-wall look while still clearing AA */
    color: #63727d;
    text-decoration: none;
    white-space: nowrap;
    line-height: 1;
    padding: 10px 18px;
    border-radius: 999px;
    transition: background 0.2s;
  }

  .ticker-group a:hover {
    background: rgba(22, 35, 44, 0.06);
  }

  .ticker-group a:focus-visible {
    background: rgba(22, 35, 44, 0.06);
    outline: 2px solid var(--blue-dark);
    outline-offset: 2px;
  }

  /* Placeholder wordmarks: varied faces stand in for real logo files */
  .tk-wide {
    font-family: "Jost", sans-serif;
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: 0.22em;
  }

  .tk-serif {
    font-family: "DM Serif Display", Georgia, serif;
    font-size: 1.45rem;
  }

  .tk-geo {
    font-family: "Jost", sans-serif;
    font-size: 1.5rem;
    font-weight: 400;
  }

  .tk-sans {
    font-family: "Poppins", sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
  }

  @keyframes ticker-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none;
    }

    .ticker-viewport {
      overflow-x: auto;
    }

    .ticker-group[aria-hidden="true"] {
      display: none;
    }
  }

  /* Who We Are */
  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 72px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 120px 40px;
    color: var(--ink);
  }

  /* Shared by every section heading so they cannot drift apart */
  .section-heading {
    margin: 0 0 24px;
    color: var(--blue);
    font-family: "DM Serif Display", Georgia, serif;
    font-weight: 400;
    font-size: clamp(2rem, 3.9vw, 3.2rem);
    line-height: 1.08;
  }

  /* Sections are carried by one serif sentence, sized between the heading and
     the body copy so it reads as a statement rather than a paragraph.
     Lora rather than the heading's DM Serif Display: DM Serif ships a single
     thick-stemmed cut that reads bold at text sizes. */
  .section-statement {
    margin: 0 0 26px;
    color: #3d4b55;
    font-family: "Lora", Georgia, serif;
    font-weight: 400;
    font-size: clamp(1.1rem, 1.85vw, 1.45rem);
    line-height: 1.5;
  }

  .about p {
    margin: 0 0 18px;
    max-width: 520px;
  }

  /* Eyebrow label above the heading (class-scoped so it beats `.about p`) */
  .about .about-eyebrow {
    margin-bottom: 14px;
    color: var(--blue-dark);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    padding-bottom: 3px;
    color: var(--blue-dark);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    border-bottom: 1px solid rgba(34, 116, 171, 0.35);
    transition: color 0.2s, border-color 0.2s;
  }

  .text-link:hover {
    color: var(--blue-deep);
    border-color: var(--blue-deep);
  }

  .text-link-arrow {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s;
  }

  .text-link:hover .text-link-arrow {
    transform: translateX(3px);
  }

  /* Arch: an oversized top radius gets clamped by the browser to half the
     element's width, giving a true semicircular top that flows into straight
     sides and a flat bottom edge. Reverts to a rounded rect once stacked. */
  .about-image {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 1000px 1000px 0 0;
  }

  .about-image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e8eef2;
    color: #8a9aa4;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* Treatments */
  .treatments {
    background: var(--midnight);
    padding: 104px 0;
    /* Redefining the token flips every rule inside this section to a light
       hairline, including the ones in the responsive blocks below */
    --hairline: rgba(255, 255, 255, 0.18);
  }

  .treatments .section-heading {
    color: #fff;
  }

  .treatments-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .treatments .section-statement {
    max-width: 640px;
    margin-bottom: 56px;
    color: rgba(255, 255, 255, 0.85);
  }

  /* Hairlines come from the grid's top border plus a left border per column,
     so the rules meet exactly with no doubled-up lines. */
  .treatment-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hairline);
  }

  .treatment {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 34px 30px 0;
    border-left: 1px solid var(--hairline);
  }

  .treatment:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .treatment:last-child {
    padding-right: 0;
  }

  /* Secondary text is white held back by opacity rather than a grey, so the
     hierarchy survives without introducing an off-palette colour */
  .treatment-num {
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
  }

  .treatment-title {
    margin: 26px 0 12px;
    color: #fff;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .treatment-copy {
    margin: 0 0 22px;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .treatments .text-link {
    color: #fff;
    border-bottom-color: rgba(255, 255, 255, 0.4);
  }

  .treatments .text-link:hover {
    color: #fff;
    border-bottom-color: #fff;
  }

  /* Pins every Learn More to the same baseline despite uneven copy lengths */
  .treatment .text-link {
    margin-top: auto;
  }

  /* Tablet: links move into a full-screen menu behind a round toggle */
  @media (max-width: 1024px) {
    :root {
      --nav-pad-y: 16px;
      --nav-pad-x: 18px;
    }

    .navbar {
      display: flex;
    }

    .nav-links {
      position: fixed;
      inset: 0;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 20px;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: rgba(20, 30, 38, 0.96);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.25s, visibility 0.25s;
    }

    .nav-links a {
      color: #fff;
      font-size: 1.15rem;
    }

    .nav-links a:hover {
      background: rgba(255, 255, 255, 0.1);
    }

    .nav-links.open {
      opacity: 1;
      visibility: visible;
    }

    .nav-toggle {
      display: flex;
      position: relative;
      z-index: 1;
    }

    .nav-toggle[aria-expanded="true"] span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .nav-toggle[aria-expanded="true"] span:nth-child(2) {
      opacity: 0;
    }

    .nav-toggle[aria-expanded="true"] span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    .logo {
      margin-right: auto;
    }

    .nav-actions {
      margin-right: 10px;
    }

    /* Two columns: the odd cards start a row, so they lose the left rule */
    .treatment-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .treatment:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }

    .treatment:nth-child(even) {
      padding-right: 0;
    }

    .treatment:nth-child(n + 3) {
      margin-top: 34px;
      border-top: 1px solid var(--hairline);
    }
  }

  /* Phone: thinner bezel, icons dropped so the button fits */
  @media (max-width: 600px) {
    :root {
      --frame: 10px;
    }

    .hero {
      border-radius: 22px;
    }

    :root {
      --nav-pad-y: 14px;
      --nav-pad-x: 14px;
    }

    .logo {
      gap: 8px;
    }

    .logo-mark {
      width: 36px;
    }

    .logo-top {
      font-size: 0.5rem;
      margin-bottom: 3px;
    }

    .logo-name {
      font-size: 1.1rem;
    }

    .nav-icon {
      display: none;
    }

    .nav-actions {
      padding: 4px;
    }

    .nav-button {
      font-size: 0.78rem;
      padding: 8px 16px;
    }

    /* Smaller wordmarks so more than one credential is on screen at a time */
    .ticker {
      padding: 34px 0 38px;
    }

    .ticker-label {
      margin-bottom: 22px;
    }

    .ticker-group {
      gap: 24px;
      padding-right: 24px;
    }

    .ticker-group a {
      padding: 8px 12px;
    }

    .tk-wide {
      font-size: 1.05rem;
      letter-spacing: 0.18em;
    }

    .tk-serif {
      font-size: 1.1rem;
    }

    .tk-geo {
      font-size: 1.15rem;
    }

    .tk-sans {
      font-size: 0.95rem;
    }

    .about {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 72px 20px;
    }

    .about-image {
      aspect-ratio: 4 / 3;
      border-radius: 22px;
    }

    .treatments {
      padding: 72px 0;
    }

    .treatments-inner {
      padding: 0 20px;
    }

    .treatments .section-statement {
      margin-bottom: 40px;
    }

    /* One column: every card after the first carries the divider */
    .treatment-grid {
      grid-template-columns: 1fr;
    }

    .treatment,
    .treatment:nth-child(odd),
    .treatment:nth-child(even) {
      padding: 28px 0 0;
      border-left: 0;
    }

    .treatment:nth-child(n + 2) {
      margin-top: 0;
      border-top: 1px solid var(--hairline);
    }

    .hero-button {
      font-size: 0.66rem;
      letter-spacing: 0.06em;
      padding: 14px 22px;
    }
  }

  /* Small phones: the hero button is the call to action, so drop the header one */
  @media (max-width: 400px) {
    .nav-actions {
      display: none;
    }

    .hero {
      padding-left: 14px;
      padding-right: 14px;
    }

    .hero-button {
      gap: 8px;
      letter-spacing: 0.04em;
      padding: 14px 18px;
    }
  }

  /* ------------------------------------------------------------------
     Scroll effects (CSS only, no JavaScript).
     Browsers without support keep the static layout above.
     ------------------------------------------------------------------ */

  /* Flips from 0 to 1 once the page is scrolled past ~60px (integers round at the halfway point) */
  @property --scrolled {
    syntax: "<integer>";
    inherits: true;
    initial-value: 0;
  }

  @supports (animation-timeline: scroll()) {
    html {
      animation: scroll-flag linear both;
      animation-timeline: scroll(root);
      animation-range: 0 120px;
    }

    @keyframes scroll-flag {
      to {
        --scrolled: 1;
      }
    }

    /* Bezel fades from frosted to solid white within the first third of a screen */
    .hero-frame::after {
      animation: bezel-to-white linear both;
      animation-timeline: scroll(root);
      animation-range: 0 30vh;
    }

    @keyframes bezel-to-white {
      to {
        background: #fff;
      }
    }

    /* Navbar: always pinned flush to the top edge, so its glass bar is never detached.
       At rest the padding holds the pills where they sit in the framed hero.
       Past the flag: the items slide up and shrink first, then the glass fills in.
       Scrolling back reverses it: glass fades out, then the items drop back down. */
    .navbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      padding: calc(var(--frame) + var(--nav-pad-y)) calc(var(--frame) + var(--nav-pad-x));
      --nav-delay: 0.15s;
      transition: padding 0.3s ease var(--nav-delay);
    }

    /* The bar's glass lives on a pseudo-element: a backdrop-filter on .navbar itself
       would trap the fixed full-screen mobile menu inside the bar */
    .navbar::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      /* Dark tint keeps the white text readable over the white sections below */
      background: rgba(22, 35, 44, 0.55);
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      -webkit-backdrop-filter: var(--glass-blur);
