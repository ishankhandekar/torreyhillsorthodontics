  /* Flips from 0 to 1 once the page is scrolled past ~60px (integers round at the halfway point) */
  @property --scrolled {
    syntax: "<integer>";
    inherits: true;
    initial-value: 0;
  }

  @supports (animation-timeline: scroll()) {
    html {
      animation: scroll-flag linear both;
      animation-timeline: scroll(root);
      animation-range: 0 120px;
    }

    @keyframes scroll-flag {
      to {
        --scrolled: 1;
      }
    }

    /* Navbar: always pinned flush to the top edge, so its glass bar is never detached.
       At rest the padding holds the pills where they sit in the framed hero.
       Past the flag: the items slide up and shrink first, then the glass fills in.
       Scrolling back reverses it: glass fades out, then the items drop back down. */
    .navbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      padding: 22px calc(var(--frame) + var(--nav-pad-x)) 18px;
      --nav-delay: 0.15s;
      transition: padding 0.3s ease var(--nav-delay);
    }

    /* The bar's glass lives on a pseudo-element: a backdrop-filter on .navbar itself
       would trap the fixed full-screen mobile menu inside the bar */
    .navbar::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      /* Solid --ink, no blur. The tinted glass belonged to the pills, and
         with those gone it was the only glassy thing left. Ink also means
         the rail's white type carries straight through from the hero
         instead of having to invert. */
      background: var(--ink);
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      opacity: 0;
      transition: opacity 0.2s ease;
    }

    /* Everything that shrinks for the compact bar moves on the same timing */
    .logo,
    .logo-mark,
    .logo-name,
    .nav-links a,
    .nav-trigger,
    .nav-cta {
      transition: all 0.3s ease var(--nav-delay);
    }

    .nav-links,
    .nav-actions,
    .nav-toggle {
      /* opacity/visibility keep the mobile menu's fade */
      transition: gap 0.3s ease var(--nav-delay), width 0.3s ease var(--nav-delay),
        height 0.3s ease var(--nav-delay), opacity 0.25s, visibility 0.25s;
    }

    /* The hairline is the rail at rest; once the solid bar fades in behind
       it there are two horizontal lines doing one job, so it goes */
    .navbar::after {
      transition: opacity 0.25s ease;
    }

    @container style(--scrolled: 1) {
