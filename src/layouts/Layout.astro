---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Astro rewrites its own bundle URLs for `base`, but not paths we hardcode.
// Building them from BASE_URL keeps them correct at a subpath or at the root.
const asset = (path: string) =>
  `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${path}`;
---

<!doctype html>
<html lang="en" style={`--hero-image: url("${asset("images/hero.jpg")}")`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={asset("favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Lora:wght@400&family=Jost:wght@400;500&family=Poppins:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    {/* Rebuilt from the supplied loading.lottie rather than played with it:
        the file is ten white discs scaling up and fading out on a stagger,
        which is a handful of keyframes here instead of ~160kb of lottie-web
        for a half-second splash. Pure CSS, so it clears itself without JS. */}
    <div class="splash" aria-hidden="true">
      <div class="splash-rings">
        <span></span><span></span><span></span><span></span>
      </div>
    </div>
    <slot />
  </body>
</html>

<script>
  import Lenis from "lenis";

  // Touch scrolling already has physics and runs off the main thread, so
  // smoothing it there makes things worse, not better. Reduced-motion users
  // have explicitly asked for none of this.
  const coarse = window.matchMedia("(pointer: coarse)").matches;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!coarse && !reduced) {
    // lerp rather than a fixed duration: each frame closes a share of the
    // remaining distance, so it moves off quickly and settles rather than
    // stopping. Lenis normalises the rate, so 120Hz matches 60Hz.
    new Lenis({ lerp: 0.1, smoothWheel: true, autoRaf: true });
  }
</script>



<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  :root {
    /* Inset of the navbar from the viewport edge. It was the hero bezel's
       width first, which is why the scrolled navbar padding still adds it. */
    --frame: 14px;
    --ink: #16232c;
    /* Brand blue: 3.96:1 on white, so it is only AA-safe for large text
       (the section headings). Small text and white-on-blue fills use
       --blue-dark (5.06:1); hover states go to --blue-deep (5.81:1). */
    --blue: #2a86c4;
    --blue-dark: #2274ab;
    --blue-deep: #1f6a9e;
    /* The brand blue lifted for dark surfaces — --blue-dark is only 3.17:1
       on --ink, this is 6.37:1 */
    --blue-light: #5fabdd;
    --muted: #4a5a64;
    /* Tinted band behind the ticker */
    --band: #f7f9fa;
    /* Midnight navy, pitched near the hero's own dark wash so the two dark
       areas of the page read as the same colour family */
    --midnight: #3a506b;
    /* The office tour, one step deeper than the treatments band. Same hue and
       saturation as --midnight, dropped from 32% to 20% lightness: a 1.59:1
       step, which reads as a deliberate change without the two sections
       looking unrelated. */
    --midnight-deep: #243142;
    --hairline: rgba(22, 35, 44, 0.12);
    /* Horizontal inset of the rail's contents and its rule */
    --nav-pad-x: 24px;
  }

  body {
    margin: 0;
    font-family: "Poppins", system-ui, sans-serif;
    background: #fff;
  }

  /* Loading splash */
  .splash {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    background: var(--ink);
    /* Holds for 0.5s, then fades and takes itself out of the way. No script,
       so a JS failure cannot leave the page covered. */
    animation: splash-out 0.32s ease 0.5s forwards;
  }

  @keyframes splash-out {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  .splash-rings {
    position: relative;
    width: 96px;
    height: 96px;
  }

  /* Each disc expands from the centre and fades, staggered — the original
     spaced these a second apart, tightened here so several are visible
     inside half a second */
  .splash-rings span {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #fff;
    opacity: 0;
    animation: splash-ping 1s cubic-bezier(0.2, 0.6, 0.3, 1) infinite;
  }

  .splash-rings span:nth-child(2) {
    animation-delay: 0.16s;
  }

  .splash-rings span:nth-child(3) {
    animation-delay: 0.32s;
  }

  .splash-rings span:nth-child(4) {
    animation-delay: 0.48s;
  }

  @keyframes splash-ping {
    0% {
      transform: scale(0.2);
      opacity: 0.85;
    }
    100% {
      transform: scale(1);
      opacity: 0;
    }
  }

  /* Nothing to watch, so skip straight past it */
  @media (prefers-reduced-motion: reduce) {
    .splash {
      animation-delay: 0s;
      animation-duration: 0.01s;
    }

    .splash-rings span {
      animation: none;
    }
  }

  /* Navbar: sits inside the framed hero, with the links in floating white pills */
  .navbar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    /* Equal side columns keep the links truly centered on the page */
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 28px;
    padding: 22px calc(var(--frame) + var(--nav-pad-x)) 18px;
  }

  /* The rule is the rail. Flush to the page edges rather than inset like the
     old floating bar, because a hairline that stops short of the edge reads
     as a box without sides. */
  .navbar::after {
    content: "";
    position: absolute;
    left: calc(var(--frame) + var(--nav-pad-x));
    right: calc(var(--frame) + var(--nav-pad-x));
    bottom: 0;
    height: 1px;
    background: rgba(255, 255, 255, 0.28);
  }

  .logo {
    justify-self: start;
    display: flex;
    align-items: center;
    gap: 10px;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
  }

  .logo-mark {
    width: 34px;
    height: auto;
    fill: #fff;
  }

  .logo-wire {
    fill: none;
    stroke: #fff;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  /* Two-line lockup, used wherever the logo is the focal point rather than
     a corner mark. Same face as the single-line version below, so the two
     read as one wordmark at two sizes rather than two different marks. */
  .logo-text {
    display: flex;
    flex-direction: column;
    font-family: "Jost", "Poppins", sans-serif;
    line-height: 1;
  }

  .logo-top {
    margin-bottom: 5px;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .logo-stacked .logo-name {
    font-size: 2.05rem;
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  .logo-name {
    font-family: "Jost", "Poppins", sans-serif;
    font-size: 1.16rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .nav-links {
    position: relative;
    display: flex;
    gap: 30px;
  }

  .nav-links a {
    color: #fff;
    text-decoration: none;
    font-size: 0.86rem;
    font-weight: 400;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }

  .nav-links a:hover {
    border-bottom-color: #fff;
  }

  .nav-item {
    position: relative;
    display: flex;
  }

  /* A <button> in a row of links, so every metric here has to match
     .nav-links a or the pill's items sit at different heights */
  .nav-trigger {
    display: flex;
    align-items: center;
    gap: 6px;
    border: 0;
    background: transparent;
    color: #fff;
    font-family: inherit;
    font-size: 0.86rem;
    font-weight: 400;
    padding: 0 0 2px;
    border-bottom: 1px solid transparent;
    cursor: pointer;
    transition: border-color 0.2s;
  }

  .nav-trigger:hover,
  .nav-item.open .nav-trigger {
    border-bottom-color: #fff;
  }

  .nav-caret {
    width: 8px;
    height: auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s;
  }

  .nav-item.open .nav-caret {
    transform: rotate(180deg);
  }

  .nav-menu {
    position: absolute;
    /* The trigger's baseline sits 18px above the rail's rule, so the panel
       has to clear both before it starts, or it covers the hairline */
    top: calc(100% + 28px);
    left: 0;
    min-width: 212px;
    margin: 0;
    padding: 8px;
    list-style: none;
    /* Solid, not glass. A flat rail has no pill for a translucent panel to
       belong to, and these items are the smallest type on the page. */
    background: #fff;
    border-radius: 14px;
    box-shadow: 0 20px 46px rgba(10, 22, 30, 0.22);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.18s, visibility 0.18s, transform 0.18s;
  }

  .nav-menu a,
  .nav-menu-todo {
    display: block;
    padding: 8px 12px;
    border-radius: 9px;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.86rem;
    font-weight: 400;
    white-space: nowrap;
  }

  .nav-menu a:hover {
    background: var(--band);
  }

  .nav-menu-note {
    display: block;
    margin-top: 2px;
    color: var(--muted);
    font-family: "Jost", "Poppins", sans-serif;
    font-size: 0.72rem;
    font-weight: 400;
  }

  /* PLACEHOLDER rows: no destination yet, so deliberately not a link */
  .nav-menu-todo {
    color: var(--muted);
    font-weight: 400;
    font-style: italic;
  }

  /* Click/keyboard open works regardless of hover support — a touch laptop
     above 1025px gets no :hover, so this cannot live in the query below */
  .nav-item.open > .nav-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  @media (hover: hover) and (min-width: 1025px) {
    .nav-item:hover > .nav-menu {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    /* Bridges the gap between the pill and the menu so moving the pointer down
       into it does not count as leaving the item */
    .nav-item::after {
      content: "";
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      height: 28px;
    }
  }

  .nav-actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 26px;
  }

  .nav-status {
    margin: 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.82rem;
    font-weight: 400;
    white-space: nowrap;
  }

  .nav-status a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-status a:hover {
    color: #fff;
  }

  .nav-dot {
    margin: 0 6px;
    opacity: 0.55;
  }

  /* The primary action, but a link rather than a pill — a filled button is
     the one element that would not belong on a rail of plain type. The
     permanent underline is what separates it from the nav links. */
  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 3px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.55);
    color: #fff;
    text-decoration: none;
    font-size: 0.86rem;
    font-weight: 500;
    white-space: nowrap;
    transition: border-color 0.2s;
  }

  .nav-cta:hover {
    border-bottom-color: #fff;
  }

  .nav-cta svg {
    width: 11px;
    height: 11px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Plain bars. A glass disc was the last pill left on an otherwise flat
     rail, and it read as a button that had wandered in from the old navbar. */
  .nav-toggle {
    display: none;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    gap: 5px;
    width: 26px;
    height: 26px;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .nav-toggle span {
    width: 22px;
    height: 1.5px;
    background: #fff;
    transition: transform 0.25s, opacity 0.25s;
  }

  /* The middle bar is shorter at rest and squares up when open */
  .nav-toggle span:nth-child(2) {
    width: 15px;
  }

  /* Only a positioning context for the navbar now that the bezel is gone */
  .hero-frame {
    position: relative;
  }

  /* Full-bleed photo. The copy stacks at the bottom with the credential
     marquee beneath it, so the whole lower band is one left-aligned column. */
  .hero {
    position: relative;
    z-index: 1;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  /* Mirrored so the face sits on the right, clear of the copy on the left */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--hero-image) 35% 30% / cover no-repeat;
    transform: scaleX(-1);
  }

  /* Both washes on one layer, since ::before is carrying the photo now: the
     first darkens the top for the white logo, the second keeps the headline
     readable against a bright sky. */
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(0, 0, 0, 0.35), transparent 220px),
      linear-gradient(
        rgba(10, 30, 45, 0.1) 30%,
        rgba(10, 30, 45, 0.55) 74%,
        rgba(10, 30, 45, 0.72)
      );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    /* Deliberately narrow so the headline wraps into a tight block rather
       than running across the photo */
    max-width: 680px;
    /* Lines the headline up with the logo in the navbar */
    padding: 0 calc(var(--frame) + var(--nav-pad-x)) 11vh;
  }

  .hero h1 {
    margin: 0 0 20px;
    color: #fff;
    font-family: "DM Serif Display", Georgia, serif;
    font-weight: 400;
    font-size: clamp(2.2rem, 4.6vw, 4.2rem);
    line-height: 1.05;
    letter-spacing: 0.005em;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.25);
  }

  /* Narrower than the headline so the block stays a column rather than
     spreading across the photo */
  .hero-copy {
    margin: 0 0 30px;
    max-width: 480px;
    color: rgba(255, 255, 255, 0.9);
    font-family: "Jost", "Poppins", sans-serif;
    font-size: clamp(0.95rem, 1.15vw, 1.08rem);
    line-height: 1.6;
  }

  .hero-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--blue-dark);
    color: #fff;
    text-decoration: none;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 12px 22px;
    border-radius: 8px;
    transition: background 0.2s;
  }

  .hero-button:hover {
    background: var(--blue-deep);
  }

  .hero-button-arrow {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s;
  }

  .hero-button:hover .hero-button-arrow {
    transform: translate(2px, -2px);
  }

  /* Certification ticker — lives at the foot of the hero, over the photo */
  .ticker {
    position: relative;
    z-index: 1;
    padding: 0 0 30px;
    overflow: hidden;
  }

  .ticker-label {
    margin: 0 0 16px;
    /* Same left edge as the headline and the logo */
    padding-left: calc(var(--frame) + var(--nav-pad-x));
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  /* Fades the logos out at both edges instead of clipping them hard */
  .ticker-viewport {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent,
      #000 7%,
      #000 93%,
      transparent
    );
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 7%,
      #000 93%,
      transparent
    );
  }

  .ticker-track {
    display: flex;
    width: max-content;
    animation: ticker-scroll 42s linear infinite;
  }

  .ticker-viewport:hover .ticker-track {
    animation-play-state: paused;
  }

  /* The trailing padding matches the gap so the two copies butt together
     with no visible seam at the loop point. */
  .ticker-group {
    display: flex;
    align-items: center;
    gap: 40px;
    margin: 0;
    padding: 0 40px 0 0;
    list-style: none;
  }

  .ticker-group li {
    display: flex;
  }

  /* Same soft pill on hover as the navbar links */
  .ticker-group a {
    color: rgba(255, 255, 255, 0.88);
    text-decoration: none;
    white-space: nowrap;
    line-height: 1;
    padding: 10px 18px;
    border-radius: 999px;
    transition: background 0.2s;
  }

  .ticker-group a:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  .ticker-group a:focus-visible {
    background: rgba(255, 255, 255, 0.16);
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  /* Placeholder wordmarks: varied faces stand in for real logo files */
  .tk-wide {
    font-family: "Jost", sans-serif;
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: 0.22em;
  }

  .tk-serif {
    font-family: "DM Serif Display", Georgia, serif;
    font-size: 1.45rem;
  }

  .tk-geo {
    font-family: "Jost", sans-serif;
    font-size: 1.5rem;
    font-weight: 400;
  }

  .tk-sans {
    font-family: "Poppins", sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
  }

  @keyframes ticker-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none;
    }

    .ticker-viewport {
      overflow-x: auto;
    }

    .ticker-group[aria-hidden="true"] {
      display: none;
    }
  }

  /* Who We Are */
  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 72px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 120px 40px;
    color: var(--ink);
  }

  /* Small label above a section heading */
  .section-eyebrow {
    margin: 0 0 14px;
    color: var(--blue-dark);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  /* Shared by every section heading so they cannot drift apart */
  .section-heading {
    margin: 0 0 24px;
    color: var(--blue);
    font-family: "DM Serif Display", Georgia, serif;
    font-weight: 400;
    font-size: clamp(2rem, 3.9vw, 3.2rem);
    line-height: 1.08;
  }

  /* Sections are carried by one serif sentence, sized between the heading and
     the body copy so it reads as a statement rather than a paragraph.
     Lora rather than the heading's DM Serif Display: DM Serif ships a single
     thick-stemmed cut that reads bold at text sizes. */
  .section-statement {
    margin: 0 0 26px;
    color: #3d4b55;
    font-family: "Lora", Georgia, serif;
    font-weight: 400;
    /* Sized for a paragraph rather than a single line — the larger setting
       read as a pull quote once there was more than one sentence in it. The
       looser leading keeps the serif comfortable at this size. */
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.65;
  }

  .about .section-statement {
    max-width: 520px;
  }

  /* A supporting line under a heading, rather than a statement in its own
     right: Jost — the same sans as the Learn More links and tour captions —
     at a much smaller size than .section-statement's serif. Shared so the
     dark sections cannot drift apart; colour and spacing stay per-section. */
  .section-subline {
    margin: 0;
    font-family: "Jost", "Poppins", sans-serif;
    font-size: clamp(0.9rem, 1.05vw, 1rem);
    line-height: 1.6;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    padding-bottom: 3px;
    color: var(--blue-dark);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    border-bottom: 1px solid rgba(34, 116, 171, 0.35);
    transition: color 0.2s, border-color 0.2s;
  }

  .text-link:hover {
    color: var(--blue-deep);
    border-color: var(--blue-deep);
  }

  .text-link-arrow {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s;
  }

  .text-link:hover .text-link-arrow {
    transform: translateX(3px);
  }

  /* Arch: an oversized top radius gets clamped by the browser to half the
     element's width, giving a true semicircular top that flows into straight
     sides and a flat bottom edge. Reverts to a rounded rect once stacked. */
  .about-image {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 1000px 1000px 0 0;
  }

  /* PLACEHOLDER: standing in with the hero shot until the real photo lands */
  .about-image-placeholder {
    background: var(--hero-image) center / cover no-repeat;
  }

  /* Treatments */
  .treatments {
    background: var(--band);
    padding: 104px 0;
  }

  .treatments-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .treatments .section-subline {
    max-width: 560px;
    margin-bottom: 56px;
    color: #3d4b55;
  }

  /* Hairlines come from the grid's top border plus a left border per column,
     so the rules meet exactly with no doubled-up lines. */
  .treatment-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hairline);
  }

  .treatment {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 34px 30px 0;
    border-left: 1px solid var(--hairline);
  }

  .treatment:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .treatment:last-child {
    padding-right: 0;
  }

  .treatment-num {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
  }

  .treatment-title {
    margin: 26px 0 12px;
    color: var(--ink);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .treatment-copy {
    margin: 0 0 18px;
    color: #3d4b55;
    font-size: 0.9rem;
    line-height: 1.65;
  }

  /* Short fact fragments, so they read as a spec list rather than prose */
  .treatment-points {
    margin: 0 0 22px;
    padding: 0;
    list-style: none;
  }

  .treatment-points li {
    position: relative;
    padding-left: 15px;
    color: #3d4b55;
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .treatment-points li + li {
    margin-top: 7px;
  }

  .treatment-points li::before {
    content: "";
    position: absolute;
    top: 0.58em;
    left: 0;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--blue-dark);
  }

  /* Pins every Learn More to the same baseline despite uneven copy lengths */
  .treatment .text-link {
    margin-top: auto;
  }

  /* Office tour */
  .tour {
    background: #fff;
    padding: 104px 0;
  }

  .tour-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .tour-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }

  .tour .section-heading {
    margin: 0;
  }

  /* Keeps the heading and its subline together on the left, so space-between
     still pushes the CTA to the right edge */
  .tour-headings {
    min-width: 0;
  }

  .tour .section-subline {
    margin-top: 10px;
    color: #3d4b55;
  }

  .tour-cta {
    flex-shrink: 0;
    padding: 15px 28px;
    border: 1px solid var(--blue-dark);
    border-radius: 8px;
    background: transparent;
    color: var(--blue-dark);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: background 0.2s, color 0.2s;
  }

  .tour-cta:hover {
    background: var(--blue-dark);
    color: #fff;
  }

  /* Each room is one full photo card, with its neighbours peeking in at the
     sides. Built on scroll-snap rather than transforms, so it swipes natively
     on touch and still works if the script never runs. */
  .tour-carousel {
    position: relative;
    margin-top: 48px;
    /* Sized so the centred card lines up with the page container while its
       neighbours run off both edges of the screen */
    --tour-side: max(20px, calc((100% - 1120px) / 2));
  }

  .tour-track {
    display: flex;
    gap: 20px;
    margin: 0;
    padding: 0 var(--tour-side);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .tour-track::-webkit-scrollbar {
    display: none;
  }

  .tour-slide {
    position: relative;
    flex: 0 0 100%;
    height: clamp(360px, 46vw, 560px);
    scroll-snap-align: center;
    border-radius: 4px;
    overflow: hidden;
    /* PLACEHOLDER: every card is the hero shot until the real photos arrive */
    background: var(--hero-image) center / cover no-repeat;
  }

  /* The copy sits at the top of the card now, so the scrim runs the other way */
  .tour-slide::after {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 68%;
    /* Holds most of its weight through the text block before falling away, so
       the copy stays readable over a pale photo as well as a dark one */
    background: linear-gradient(
      rgba(6, 14, 20, 0.86) 0%,
      rgba(6, 14, 20, 0.66) 38%,
      rgba(6, 14, 20, 0) 100%
    );
  }

  .tour-slide-text {
    position: absolute;
    inset: 34px 34px auto;
    z-index: 1;
  }

  .tour-room {
    margin: 0;
    color: #fff;
    font-family: "Jost", "Poppins", sans-serif;
    font-weight: 500;
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    line-height: 1.15;
  }

  .tour-blurb {
    margin: 10px 0 0;
    max-width: 34ch;
    color: #fff;
    font-family: "Jost", "Poppins", sans-serif;
    font-size: clamp(0.9rem, 1.05vw, 1rem);
    line-height: 1.55;
  }

  /* Centred on the card's edge, the way the reference sits them */
  .tour-arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    padding: 0;
    transform: translateY(-50%);
    border: 1px solid var(--hairline);
    border-radius: 50%;
    background: #fff;
    color: var(--ink);
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .tour-arrow:hover {
    background: var(--ink);
    color: #fff;
  }

  .tour-arrow-prev {
    left: calc(var(--tour-side) - 23px);
  }

  .tour-arrow-next {
    right: calc(var(--tour-side) - 23px);
  }

  .tour-arrow svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tour-dots {
    position: absolute;
    right: 0;
    bottom: 22px;
    left: 0;
    z-index: 2;
    display: flex;
    justify-content: center;
    gap: 9px;
  }

  .tour-dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    /* The ring keeps the dots legible over a pale photo as well as a dark one */
    background: rgba(255, 255, 255, 0.5);
    box-shadow: 0 0 0 1px rgba(6, 14, 20, 0.25);
    cursor: pointer;
    transition: background 0.2s;
  }

  .tour-dot.is-active {
    background: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .tour-track {
      scroll-behavior: auto;
    }
  }

  /* Locations / contact */
  /* The ring is wider than the viewport once the columns stack, so it is
     clipped here rather than at the column — it is meant to bleed past the
     column's edges on desktop, and clipping it there would cut it short. */
  .locations {
    background: #fff;
    padding: 104px 0;
    overflow: hidden;
  }

  .locations-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 64px;
  }

  /* The lockup carries this column instead of a section heading, so it is
     set much larger than the navbar's and in blue. --blue-dark rather than
     --blue: at 4.8:1 on the band it clears AA at every size in the lockup,
     where --blue would only be safe on the large line. */
  .contact-brand .logo {
    color: var(--blue-dark);
  }

  .contact-brand .logo-mark {
    width: 68px;
  }

  .contact-brand .logo-mark,
  .contact-brand .logo-wire {
    fill: var(--blue-dark);
    stroke: none;
  }

  .contact-brand .logo-wire {
    fill: none;
    stroke: var(--blue-dark);
  }

  .contact-tagline {
    max-width: 320px;
    margin: 26px 0 0;
    color: var(--muted);
    font-family: "Jost", "Poppins", sans-serif;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .contact-directions {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    padding-bottom: 3px;
    border-bottom: 1px solid rgba(34, 116, 171, 0.35);
    color: var(--blue-dark);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.2s, border-color 0.2s;
  }

  .contact-directions:hover {
    color: var(--blue-deep);
    border-bottom-color: var(--blue-deep);
  }

  .contact-directions svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Shrinks to its content so the ring and the text share a centre */
  .contact-details-inner {
    position: relative;
    width: fit-content;
  }

  /* Circular text is an SVG <textPath> on a circle, and the whole <svg> is
     what spins — rotating the text element would fight the path. Sized off
     the wrapper's HEIGHT: shrink-wrapped, the block is taller than it is
     wide, and a circle has to beat the diagonal to contain it. */
  .contact-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    height: 164%;
    width: auto;
    aspect-ratio: 1;
    translate: -50% -50%;
    pointer-events: none;
    user-select: none;
    animation: contact-spin 40s linear infinite;
  }

  .contact-ring text {
    font-family: "Jost", "Poppins", sans-serif;
    font-size: 25px;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    fill: var(--blue);
    fill-opacity: 0.34;
  }

  @keyframes contact-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* The ring is a sibling behind these, so each needs its own stacking
     position to paint over the arcs that cross it */
  .contact-item,
  .contact-socials {
    position: relative;
    z-index: 1;
  }

  .contact-item + .contact-item {
    margin-top: 30px;
  }

  .contact-label {
    margin: 0 0 8px;
    color: var(--blue-dark);
    font-family: "Jost", "Poppins", sans-serif;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* --muted, not --ink: at full ink the values competed with the lockup
     opposite. The phone stays a step above the other two — it is the thing
     someone is most likely to act on. */
  .contact-value {
    margin: 0;
    color: var(--muted);
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .contact-value a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }

  .contact-value a:hover {
    color: var(--blue-dark);
  }

  .contact-address {
    font-size: 0.97rem;
    font-weight: 400;
  }

  .contact-hours {
    margin: 0;
    color: var(--muted);
    font-size: 0.97rem;
    line-height: 1.7;
  }

  /* Weight alone separates the day from the time — colouring the day darker
     than the phone number would invert the hierarchy */
  .contact-hours b {
    font-weight: 600;
  }

  .contact-hours em {
    margin-left: 7px;
    color: var(--blue-dark);
    font-size: 0.74rem;
    font-style: normal;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact-socials {
    display: flex;
    gap: 12px;
    margin-top: 34px;
  }

  .contact-social {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(42, 134, 196, 0.1);
    color: var(--blue-dark);
    transition: background 0.2s, color 0.2s, transform 0.2s;
  }

  .contact-social svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .contact-social:hover {
    background: var(--blue-dark);
    color: #fff;
    transform: translateY(-2px);
  }

  .contact-social:focus-visible {
    outline: 2px solid var(--blue-dark);
    outline-offset: 3px;
  }

  .location-disclaimer {
    margin: 26px 0 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  /* ------------------------------------------------------------------
     Treatment pages (/braces and the three that will follow it).
     Everything here is generic on purpose — a treatment page is the same
     shape each time, so these carry over rather than being re-cut.
     ------------------------------------------------------------------ */

  /* Dark band, so the navbar's white links have something to sit on before
     the scrolled glass bar fades in. The top padding clears the fixed bar. */
  .tpage-head {
    background: var(--ink);
    padding: 132px 0 76px;
  }

  .tpage-head-inner,
  .tsection-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 34px;
    color: rgba(255, 255, 255, 0.45);
    font-family: "Jost", "Poppins", sans-serif;
    font-size: 0.78rem;
  }

  .crumbs a {
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
    transition: color 0.2s;
  }

  .crumbs a:hover {
    color: #fff;
  }

  .crumbs [aria-current] {
    color: #fff;
  }

  .tpage-eyebrow {
    color: var(--blue-light);
  }

  .tpage-title {
    margin: 0 0 22px;
    color: #fff;
    font-family: "DM Serif Display", Georgia, serif;
    font-weight: 400;
    font-size: clamp(2.6rem, 5.4vw, 4.4rem);
    line-height: 1.02;
  }

  .tpage-lede {
    max-width: 620px;
    margin: 0;
    color: rgba(255, 255, 255, 0.82);
    font-family: "Lora", Georgia, serif;
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.65;
  }

  /* The four headline facts. A <dl> because that is what it is: the labels
     and values are pairs, not a list of eight things. */
  .spec-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    margin: 56px 0 0;
    padding: 0;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 14px;
    overflow: hidden;
  }

  /* The gap shows the container through as hairlines; each cell paints over
     it, so the rules land between cells with none at the outer edge */
  .spec {
    padding: 22px 24px;
    background: var(--ink);
  }

  .spec-label {
    margin: 0 0 7px;
    color: var(--blue-light);
    font-family: "Jost", "Poppins", sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .spec-value {
    margin: 0;
    color: #fff;
    font-size: 1.05rem;
    font-weight: 500;
  }

  .tsection {
    padding: 104px 0;
    color: var(--ink);
  }

  .tsection-band {
    background: var(--band);
  }

  .tsplit {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 64px;
  }

  .tsplit-intro {
    align-self: start;
  }

  .tsplit-intro .section-heading {
    margin-bottom: 18px;
  }

  .tsplit-subline {
    max-width: 340px;
    color: #3d4b55;
  }

  .type-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 28px;
  }

  /* Two ruled lists side by side — what a treatment is good at against what
     it is not. Wants the full width, so it sits outside .tsplit. */
  .compare-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 56px;
    margin-top: 48px;
  }

  .compare-title {
    margin: 0 0 4px;
    color: var(--ink);
    font-family: "DM Serif Display", Georgia, serif;
    font-size: 1.25rem;
    font-weight: 400;
  }

  .type-card {
    padding: 30px 28px;
    background: var(--band);
    border-radius: 16px;
  }

  /* The cards sit on --band in the white section; on the band section they
     would vanish, so they flip to white there instead */
  .tsection-band .type-card,
  .tsection-band .care {
    background: #fff;
  }

  .type-card-title {
    margin: 0 0 12px;
    color: var(--ink);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .type-card-copy {
    margin: 0 0 18px;
    color: #3d4b55;
    font-size: 0.9rem;
    line-height: 1.65;
  }

  /* Reuses .treatment-points from the landing page, so the bullet, size and
     rhythm cannot drift from the treatment cards that link here */
  .type-card .treatment-points {
    margin-bottom: 0;
  }

  .case-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hairline);
  }

  .case-list li {
    position: relative;
    padding: 20px 0 20px 34px;
    border-bottom: 1px solid var(--hairline);
    color: #3d4b55;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .case-list li::before {
    content: "";
    position: absolute;
    top: 1.45em;
    left: 6px;
    width: 12px;
    height: 2px;
    border-radius: 1px;
    background: var(--blue-dark);
  }

  .steps-subline {
    max-width: 560px;
    margin-bottom: 56px;
    color: #3d4b55;
  }

  /* Same hairline construction as .treatment-grid: one rule on the list and
     one per column, so corners meet instead of doubling up */
  /* Column flow rather than a fixed count: these pages have three, four or
     five stages and the track count should follow the content */
  .steps {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hairline);
  }

  .step {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 30px 26px 0;
    border-left: 1px solid var(--hairline);
  }

  .step:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .step:last-child {
    padding-right: 0;
  }

  .step-num {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
  }

  .step-title {
    margin: 22px 0 10px;
    color: var(--ink);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .step-copy {
    margin: 0;
    color: #3d4b55;
    font-size: 0.85rem;
    line-height: 1.65;
  }

  .cost-grid,
  .care-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }

  .cost,
  .care {
    padding: 28px 26px;
    background: #fff;
    border-radius: 16px;
  }

  .care {
    background: var(--band);
  }

  .cost-title,
  .care-title {
    margin: 0 0 10px;
    color: var(--ink);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .cost-copy,
  .care-copy {
    margin: 0;
    color: #3d4b55;
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .cost-note {
    max-width: 680px;
    margin: 34px 0 0;
    color: #3d4b55;
    font-family: "Lora", Georgia, serif;
    font-size: 1rem;
    line-height: 1.65;
  }

  .care-grid {
    margin-top: 44px;
  }

  /* ------------------------------------------------------------------
     Bio page (/team/judy-lee)
     ------------------------------------------------------------------ */

  /* Dark, like the treatment headers, and for the same reason: the navbar's
     links are white and transparent until you scroll. No bottom padding —
     the portrait's arch is meant to meet the edge of the band. */
  .bio-hero {
    background: var(--ink);
    padding: 132px 0 0;
    overflow: hidden;
  }

  .bio-hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: end;
    gap: 64px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .bio-copy {
    padding-bottom: 96px;
  }

  .bio-name {
    margin: 0 0 16px;
    color: #fff;
    font-family: "DM Serif Display", Georgia, serif;
    font-weight: 400;
    font-size: clamp(2.8rem, 5.6vw, 4.8rem);
    line-height: 0.98;
  }

  .bio-role {
    margin: 0 0 26px;
    color: var(--blue-light);
    font-family: "Jost", "Poppins", sans-serif;
    font-size: 0.86rem;
    letter-spacing: 0.04em;
  }

  .bio-lede {
    max-width: 520px;
    margin: 0;
    color: rgba(255, 255, 255, 0.82);
    font-family: "Lora", Georgia, serif;
    font-size: clamp(1rem, 1.3vw, 1.12rem);
    line-height: 1.68;
  }

  .bio-actions {
    display: flex;
    align-items: center;
    gap: 26px;
    margin-top: 36px;
  }

  .bio-button {
    padding: 14px 26px;
    border-radius: 999px;
    background: var(--blue-dark);
    color: #fff;
    text-decoration: none;
    font-family: "Jost", "Poppins", sans-serif;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background 0.2s;
  }

  .bio-button:hover {
    background: var(--blue-deep);
  }

  .bio-phone {
    color: #fff;
    text-decoration: none;
    font-family: "Jost", "Poppins", sans-serif;
    font-size: 0.92rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    padding-bottom: 2px;
    transition: border-color 0.2s;
  }

  .bio-phone:hover {
    border-color: #fff;
  }

  .bio-portrait {
    position: relative;
    align-self: end;
  }

  /* Warm halo behind the arch. Blurred and well under the photo's opacity,
     so it reads as light spilling rather than a shape. */
  .bio-portrait::before {
    content: "";
    position: absolute;
    inset: 10% -8% 0 -8%;
    border-radius: 999px 999px 0 0;
    background: radial-gradient(
      62% 52% at 50% 32%,
      rgba(237, 124, 18, 0.34),
      transparent 70%
    );
    filter: blur(28px);
  }

  /* The arch is the whole idea: a doorway shape sitting on the band's edge,
     so it reads as a portrait rather than another photo panel. */
  .bio-photo {
    position: relative;
    height: clamp(400px, 50vw, 580px);
    border-radius: 999px 999px 0 0;
    background: var(--hero-image) 50% 24% / cover no-repeat;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
  }

  /* Stats sit in the same dark band, under both columns */
  .bio-stats {
    background: var(--ink);
    padding: 0 0 86px;
  }

  .bio-stats-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 56px 40px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .bio-quote-section {
    padding: 112px 0;
    color: var(--ink);
  }

  .bio-quote {
    max-width: 880px;
    margin: 0 auto;
    padding: 0 40px;
    text-align: center;
  }

  .bio-quote-rule {
    width: 38px;
    height: 3px;
    margin: 0 auto 32px;
    border-radius: 2px;
    background: var(--blue-dark);
  }

  .bio-quote p {
    margin: 0;
    color: var(--ink);
    font-family: "Lora", Georgia, serif;
    font-size: clamp(1.25rem, 2.3vw, 1.85rem);
    line-height: 1.5;
  }

  .bio-quote-attr {
    margin: 28px 0 0;
    color: var(--muted);
    font-family: "Jost", "Poppins", sans-serif;
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  /* Dated career entries. A year column rather than a dot-and-line timeline:
     the dates are the information, so they get their own column. */
  .cv {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hairline);
  }

  .cv li {
    display: grid;
    grid-template-columns: 108px minmax(0, 1fr);
    gap: 32px;
    padding: 26px 0;
    border-bottom: 1px solid var(--hairline);
  }

  .cv-year {
    color: var(--blue-dark);
    font-family: "Jost", "Poppins", sans-serif;
    font-size: 0.84rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .cv-title {
    margin: 0 0 6px;
    color: var(--ink);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .cv-copy {
    margin: 0;
    color: #3d4b55;
    font-size: 0.9rem;
    line-height: 1.65;
  }

  /* ------------------------------------------------------------------
     Photography on /first-visit
     PLACEHOLDER IMAGERY: both of these are the shared hero photo at
     different crops, standing in until real office photography exists.
     They are background divs rather than <img> because they are decorative
     — the caption carries the content — which is the same convention the
     about, tour and bio placeholders use.
     ------------------------------------------------------------------ */

  /* Pairs with .visit-figure: the band is pulled up 120px, so the header
     needs a deeper foot or the image lands on top of the spec strip */
  /* Doubled class so it outranks the plain .tpage-head padding shorthand
     wherever that is redeclared — the responsive block sets the shorthand
     later in the file and would otherwise win the tie. */
  .tpage-head.tpage-head-tall {
    padding-bottom: 162px;
  }

  /* Straddles the header's bottom edge, so the band reads as one composition
     with the dark block rather than a picture dropped into the page */
  .visit-figure {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: -120px auto 0;
    padding: 0 40px;
  }

  .visit-photo {
    height: clamp(230px, 29vw, 380px);
    border-radius: 18px;
    background: var(--hero-image) 50% 18% / cover no-repeat;
    box-shadow: 0 30px 64px rgba(10, 22, 30, 0.3);
  }

  .visit-caption {
    margin: 16px 0 0;
    color: var(--muted);
    font-family: "Jost", "Poppins", sans-serif;
    font-size: 0.82rem;
    line-height: 1.55;
  }

  /* Sits under the intro copy in a .tsplit's left column. A different crop
     from the band above, so it does not read as the same picture twice. */
  .visit-inline-photo {
    height: 280px;
    margin-top: 30px;
    border-radius: 16px;
    background: var(--hero-image) 68% 46% / cover no-repeat;
  }

  /* FAQ */
  .faq {
    background: var(--band);
    padding: 104px 0;
  }

  .faq-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 64px;
  }

  /* Top-aligned rather than stretched to the list's height. Not sticky: the
     FAQ is the last section and shorter than a typical viewport, so there is
     never anything for it to stick against. */
  .faq-intro {
    align-self: start;
  }

  .faq-intro .section-heading {
    margin-bottom: 18px;
  }

  .faq-intro .section-subline {
    max-width: 330px;
    color: #3d4b55;
  }

  .faq-item {
    border-top: 1px solid var(--hairline);
  }

  .faq-item:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .faq-item summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding: 22px 0;
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  /* DM Serif Display is the heavy serif in the system. Its single cut IS the
     heavy one, so the weight stays at 400 — asking for 600 here would make the
     browser smear a fake bold over an already-thick face. */
  .faq-question {
    color: var(--ink);
    font-family: "DM Serif Display", Georgia, serif;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.4;
    transition: color 0.2s;
  }

  .faq-item summary:hover .faq-question {
    color: var(--blue-dark);
  }

  .faq-item summary:focus-visible {
    outline: 2px solid var(--blue-dark);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .faq-icon {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    margin-top: 4px;
    fill: none;
    stroke: var(--blue-dark);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.25s ease;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
  }

  .faq-answer {
    margin: 0;
    padding: 0 40px 24px 0;
    color: #3d4b55;
    font-size: 0.92rem;
    line-height: 1.7;
  }

  /* Native <details> snaps open. Where the browser can animate to a keyword
     size it slides instead; everywhere else it just opens. */
  @supports (interpolate-size: allow-keywords) {
    .faq-list {
      interpolate-size: allow-keywords;
    }

    .faq-item::details-content {
      block-size: 0;
      overflow: hidden;
      transition: block-size 0.28s ease, content-visibility 0.28s allow-discrete;
    }

    .faq-item[open]::details-content {
      block-size: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-icon,
    .faq-item::details-content {
      transition: none;
    }
  }

  /* Closing call to action */
  /* Padded top and bottom so the card floats in white rather than butting
     against the grey FAQ band above it */
  .consult {
    background: #fff;
    padding: 104px 0;
  }

  .consult-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* The one dark surface left on the page, so the last thing you scroll to
     reads as the close rather than another band of content */
  .consult-card {
    padding: 92px 40px;
    border-radius: 16px;
    background: var(--ink);
    text-align: center;
  }

  .consult-heading {
    margin: 0 0 18px;
    color: #fff;
    font-family: "DM Serif Display", Georgia, serif;
    font-weight: 400;
    font-size: clamp(1.9rem, 3.4vw, 2.9rem);
    line-height: 1.12;
  }

  .consult-copy {
    margin: 0 auto 32px;
    max-width: 520px;
    color: rgba(255, 255, 255, 0.78);
    font-family: "Jost", "Poppins", sans-serif;
    font-size: clamp(0.9rem, 1.05vw, 1rem);
    line-height: 1.65;
  }

  .consult-button {
    display: inline-block;
    padding: 14px 26px;
    border-radius: 8px;
    background: var(--blue-dark);
    color: #fff;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    transition: background 0.2s;
  }

  .consult-button:hover {
    background: var(--blue-deep);
  }

  .consult-button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  /* Submitted dialog. The UA gives this a border, padding and auto margins —
     all cleared below. Everything that follows is ours; the browser only
     contributes the top layer, the inert background and the focus trap. */
  .sent {
    max-width: 440px;
    margin: auto;
    padding: 44px 40px 40px;
    border: 0;
    border-radius: 16px;
    background: var(--ink);
    color: #fff;
    text-align: center;
  }

  .sent::backdrop {
    background: rgba(8, 14, 19, 0.72);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
  }

  .sent-title {
    margin: 0 0 14px;
    color: #fff;
    font-family: "DM Serif Display", Georgia, serif;
    font-weight: 400;
    font-size: 1.7rem;
    line-height: 1.2;
  }

  .sent-copy {
    margin: 0 0 28px;
    color: rgba(255, 255, 255, 0.78);
    font-family: "Jost", "Poppins", sans-serif;
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .sent-button {
    display: inline-block;
    padding: 14px 28px;
    border-radius: 8px;
    background: var(--blue-dark);
    color: #fff;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    transition: background 0.2s;
  }

  .sent-button:hover {
    background: var(--blue-deep);
  }

  @media (max-width: 600px) {
    .sent {
      max-width: none;
      width: calc(100vw - 40px);
      padding: 36px 26px 32px;
    }
  }

  /* Dark footer. Doubled class because .footer-dark alone ties with .footer
     on specificity and the light block is defined further down. */
  .footer.footer-dark {
    background: var(--ink);
    border-top-color: rgba(255, 255, 255, 0.12);
  }

  .footer.footer-dark .logo {
    color: #fff;
  }

  /* White on dark, the same as the navbar's mark; the light footer
     paints it back to --ink */
  .footer.footer-dark .logo-mark {
    fill: #fff;
  }

  .footer.footer-dark .logo-wire {
    stroke: #fff;
  }

  .footer.footer-dark .footer-blurb,
  .footer.footer-dark .footer-group a {
    color: rgba(255, 255, 255, 0.78);
  }

  .footer.footer-dark .footer-address,
  .footer.footer-dark .footer-address a {
    color: rgba(255, 255, 255, 0.6);
  }

  .footer.footer-dark .footer-group-title {
    color: var(--blue-light);
  }

  .footer.footer-dark .footer-base {
    border-top-color: rgba(255, 255, 255, 0.12);
  }

  .footer.footer-dark .footer-copyright,
  .footer.footer-dark .footer-legal a {
    color: rgba(255, 255, 255, 0.55);
  }

  .footer.footer-dark .footer-group a:hover,
  .footer.footer-dark .footer-address a:hover,
  .footer.footer-dark .footer-legal a:hover {
    color: var(--blue-light);
  }

  /* Consultation page */
  .booking {
    /* Fills the viewport so the plate reads as the page, not a strip.
       --ink rather than a new near-black: it is the site's dark and already
       backs the Book a visit card, so the two dark surfaces match.
       color-scheme makes the native select dropdown render dark too. */
    min-height: 100vh;
    background: var(--ink);
    color-scheme: dark;
    padding: 132px 0 104px;
  }

  .booking-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .booking .section-heading {
    margin: 0 0 44px;
    color: #fff;
  }

  .booking-form {
    margin-top: 48px;
  }

  .booking-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 52px;
  }

  .booking-field {
    min-width: 0;
  }

  .booking-field-full {
    grid-column: 1 / -1;
  }

  .booking-label {
    display: block;
    margin: 0 0 8px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.9rem;
  }

  /* Kept in the label's own weight rather than the usual red: the palette
     has one accent and a second hue here would only add noise */
  .booking-required {
    color: #fff;
  }

  /* Underline fields, no box */
  .booking-input {
    display: block;
    width: 100%;
    padding: 10px 0;
    border: 0;
    /* 0.35 rather than a lighter wash: below that the rule drops under the
       3:1 a field boundary needs against --ink */
    border-bottom: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 0;
    background: transparent;
    color: #fff;
    /* Not inherited: the body's Poppins is geometric and reads soft in a
       field. A system grotesque is what an unstyled input renders in and is
       what the reference matches. */
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    font-size: 1.05rem;
    line-height: 1.5;
    transition: border-color 0.2s;
  }

  .booking-input:hover {
    border-bottom-color: rgba(255, 255, 255, 0.6);
  }

  /* The rule itself is the focus indicator, so it thickens and takes the
     accent — an outline box would fight the underline treatment */
  .booking-input:focus-visible {
    outline: none;
    padding-bottom: 9px;
    border-bottom: 2px solid var(--blue);
  }

  select.booking-input {
    appearance: none;
    cursor: pointer;
  }

  /* display:block above outranks the UA's [hidden] rule, so the native select
     kept rendering next to the custom one. Re-assert it. */
  .booking-input[hidden] {
    display: none;
  }

  /* Custom dropdown, built over the native select by the page's script */
  .combo {
    position: relative;
  }

  .combo-button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    text-align: left;
    cursor: pointer;
  }

  /* The native arrow went with appearance:none, so the affordance is drawn */
  .combo-button::after {
    content: "";
    flex-shrink: 0;
    width: 9px;
    height: 9px;
    margin-bottom: 3px;
    border-right: 1.5px solid rgba(255, 255, 255, 0.6);
    border-bottom: 1.5px solid rgba(255, 255, 255, 0.6);
    transform: rotate(45deg);
    transition: transform 0.2s;
  }

  .combo-button[aria-expanded="true"]::after {
    margin-bottom: -3px;
    transform: rotate(225deg);
  }

  .combo-list {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    left: 0;
    z-index: 5;
    margin: 0;
    padding: 6px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 10px;
    /* Opaque, not translucent: it overlaps the field below it */
    background: #1e2d38;
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.5);
    list-style: none;
  }

  .combo-option {
    padding: 11px 13px;
    border-radius: 6px;
    color: rgba(255, 255, 255, 0.85);
    font-size: 1rem;
    cursor: pointer;
  }

  /* Focus moves programmatically, so :focus rather than :focus-visible */
  .combo-option:hover,
  .combo-option:focus {
    outline: none;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  .combo-option[aria-selected="true"] {
    color: var(--blue-light);
  }

  .booking-textarea {
    resize: vertical;
  }

  .booking-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
    margin-top: 44px;
  }

  .booking-consent {
    max-width: 560px;
    margin: 0;
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.82rem;
    line-height: 1.65;
  }

  .booking-submit {
    flex-shrink: 0;
    padding: 15px 30px;
    border: 0;
    border-radius: 8px;
    background: var(--blue-dark);
    color: #fff;
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }

  .booking-submit:hover {
    background: var(--blue-deep);
  }

  /* Footer */
  .footer {
    background: var(--band);
    border-top: 1px solid var(--hairline);
    padding: 76px 0 0;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 60px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px 64px;
  }

  /* The mark is white in the navbar, so the footer paints it back to ink */
  .footer .logo {
    color: var(--ink);
  }

  .footer .logo-mark {
    width: 46px;
    fill: var(--ink);
  }

  .footer .logo-wire {
    stroke: var(--ink);
  }

  .footer-blurb {
    margin: 22px 0 18px;
    max-width: 280px;
    color: #3d4b55;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .footer-address {
    color: var(--muted);
    font-size: 0.88rem;
    font-style: normal;
    line-height: 1.85;
  }

  .footer-address a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-address a:hover {
    color: var(--blue-dark);
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }

  .footer-group-title {
    margin: 0 0 16px;
    color: var(--blue-dark);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer-group ul,
  .footer-legal {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-group li + li {
    margin-top: 10px;
  }

  .footer-group a {
    color: #3d4b55;
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }

  .footer-group a:hover {
    color: var(--blue-dark);
  }

  .footer-base {
    max-width: 1200px;
    margin: 0 auto;
    padding: 22px 40px 26px;
    border-top: 1px solid var(--hairline);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .footer-copyright {
    margin: 0;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
  }

  .footer-legal a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.82rem;
    transition: color 0.2s;
  }

  .footer-legal a:hover {
    color: var(--blue-dark);
  }

  /* Testimonials */
  .testimonials {
    background: var(--band);
    padding: 120px 0;
  }

  .testimonials-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* A little more air than the default, since the quote below it is large */
  .testimonials .section-eyebrow {
    margin-bottom: 26px;
  }

  /* Every slide occupies the same grid cell, so the track keeps the height of
     the tallest review and the bars below never jump between rotations */
  .testimonial-track {
    display: grid;
  }

  .testimonial {
    grid-area: 1 / 1;
    margin: 0;
    opacity: 0;
    /* visibility also takes inactive slides out of the accessibility tree */
    visibility: hidden;
    transition: opacity 0.5s ease, visibility 0.5s;
  }

  .testimonial.is-active {
    opacity: 1;
    visibility: visible;
  }

  /* Lora rather than the heading serif: at this size DM Serif reads as bold */
  /* Sized as a quote rather than a heading: at the old 2.9rem it matched the
     section headings, so a patient's sentence carried the same weight as the
     site's own voice. The measure is capped too, or the smaller type would
     run past 80 characters a line across the full container. */
  .testimonial-quote {
    margin: 0 0 40px;
    max-width: 820px;
    color: var(--ink);
    font-family: "Lora", Georgia, serif;
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    line-height: 1.5;
    /* Hangs the opening quote mark into the margin so the first line of text
       still lines up flush left with everything below it */
    text-indent: -0.42em;
  }

  .testimonial-author {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .testimonial-avatar {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--blue-dark);
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .testimonial-meta {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .testimonial-name {
    color: var(--ink);
    font-size: 1rem;
    font-weight: 600;
  }

  .testimonial-stars {
    display: flex;
    gap: 2px;
  }

  .testimonial-star {
    width: 15px;
    height: 15px;
    fill: #f4b400;
  }

  .testimonial-source {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .testimonial-bars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    gap: 14px;
    margin-top: 64px;
  }

  /* The button is 24px tall for a usable target; the visible rule is 2px */
  .testimonial-bar {
    position: relative;
    height: 24px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .testimonial-bar::before {
    content: "";
    position: absolute;
    inset: calc(50% - 1px) 0 auto;
    height: 2px;
    background: rgba(22, 35, 44, 0.15);
  }

  .testimonial-bar-fill {
    position: absolute;
    inset: calc(50% - 1px) auto auto 0;
    height: 2px;
    width: 0;
    background: var(--ink);
    /* Only used when the bars reset at wrap-around; the running animation
       takes over the width while a bar is active */
    transition: width 0.35s ease;
  }

