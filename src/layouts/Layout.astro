      transition: background 0.3s ease var(--nav-delay), border-color 0.3s ease var(--nav-delay),
        padding 0.3s ease var(--nav-delay), width 0.3s ease var(--nav-delay),
        height 0.3s ease var(--nav-delay), opacity 0.25s, visibility 0.25s;
    }

    @container style(--scrolled: 1) {
      .navbar {
        --nav-delay: 0s;
