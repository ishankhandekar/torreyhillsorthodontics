---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Astro rewrites its own bundle URLs for `base`, but not paths we hardcode.
// Building them from BASE_URL keeps them correct at a subpath or at the root.
const asset = (path: string) =>
  `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${path}`;
---

<!doctype html>
<html lang="en" style={`--hero-image: url("${asset("images/hero.jpg")}")`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={asset("favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Lora:wght@400&family=Jost:wght@400;500&family=Poppins:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  import Lenis from "lenis";

  // Touch scrolling already has physics and runs off the main thread, so
  // smoothing it there makes things worse, not better. Reduced-motion users
  // have explicitly asked for none of this.
  const coarse = window.matchMedia("(pointer: coarse)").matches;
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!coarse && !reduced) {
    // lerp rather than a fixed duration: each frame closes a share of the
    // remaining distance, so it moves off quickly and settles rather than
    // stopping. Lenis normalises the rate, so 120Hz matches 60Hz.
    new Lenis({ lerp: 0.1, smoothWheel: true, autoRaf: true });
  }
</script>



<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  :root {
    /* Inset of the navbar from the viewport edge. It was the hero bezel's
       width first, which is why the scrolled navbar padding still adds it. */
    --frame: 14px;
    --ink: #16232c;
    /* Brand blue: 3.96:1 on white, so it is only AA-safe for large text
       (the section headings). Small text and white-on-blue fills use
       --blue-dark (5.06:1); hover states go to --blue-deep (5.81:1). */
    --blue: #2a86c4;
    --blue-dark: #2274ab;
    --blue-deep: #1f6a9e;
    --muted: #4a5a64;
    /* Tinted band behind the ticker */
    --band: #f7f9fa;
    /* Midnight navy, pitched near the hero's own dark wash so the two dark
       areas of the page read as the same colour family */
    --midnight: #3a506b;
    /* The office tour, one step deeper than the treatments band. Same hue and
       saturation as --midnight, dropped from 32% to 20% lightness: a 1.59:1
       step, which reads as a deliberate change without the two sections
       looking unrelated. */
    --midnight-deep: #243142;
    --hairline: rgba(22, 35, 44, 0.12);
    /* Frosted-glass surface shared by the nav pills and the menu toggle */
    --glass-bg: rgba(255, 255, 255, 0.16);
    --glass-border: rgba(255, 255, 255, 0.28);
    --glass-blur: blur(14px) saturate(140%);
    /* Navbar inner spacing (the scroll effect adds --frame on top of this) */
    --nav-pad-y: 10px;
    --nav-pad-x: 24px;
  }

  body {
    margin: 0;
    font-family: "Poppins", system-ui, sans-serif;
    background: #fff;
  }

  /* Navbar: sits inside the framed hero, with the links in floating white pills */
  .navbar {
    position: absolute;
    top: var(--frame);
    left: var(--frame);
    right: var(--frame);
    z-index: 10;
    /* Equal side columns keep the links truly centered on the page */
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: var(--nav-pad-y) var(--nav-pad-x);
  }

  .logo {
    justify-self: start;
    display: flex;
    align-items: center;
    gap: 10px;
    color: #fff;
    text-decoration: none;
    white-space: nowrap;
  }

  .logo-mark {
    width: 42px;
    height: auto;
    fill: #fff;
  }

  .logo-wire {
    fill: none;
    stroke: #fff;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    font-family: "Jost", "Poppins", sans-serif;
    line-height: 1;
  }

  .logo-top {
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-bottom: 3px;
  }

  .logo-name {
    font-size: 1.28rem;
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  .nav-links {
    display: flex;
    gap: 2px;
    padding: 5px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border-radius: 999px;
  }

  .nav-links a {
    color: #fff;
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 500;
    padding: 7px 14px;
    border-radius: 999px;
    transition: background 0.2s;
  }

  .nav-links a:hover {
    background: rgba(255, 255, 255, 0.18);
  }

  .nav-actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 5px 5px 5px 15px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border-radius: 999px;
  }

  .nav-icon {
    display: flex;
    color: #fff;
  }

  .nav-phone {
    display: flex;
    align-items: center;
    gap: 7px;
    color: #fff;
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 500;
    white-space: nowrap;
    transition: opacity 0.2s;
  }

  .nav-phone:hover {
    opacity: 0.75;
  }

  .nav-phone svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    fill: currentColor;
  }

  .nav-icon svg {
    width: 15px;
    height: 15px;
    fill: currentColor;
  }

  .nav-button {
    color: #fff;
    background: var(--ink);
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 500;
    padding: 7px 17px;
    border-radius: 999px;
    transition: background 0.2s;
  }

  .nav-button:hover {
    background: var(--blue-dark);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border-radius: 50%;
    cursor: pointer;
  }

  .nav-toggle span {
    width: 18px;
    height: 2px;
    background: #fff;
    transition: transform 0.25s, opacity 0.25s;
  }

  /* Only a positioning context for the navbar now that the bezel is gone */
  .hero-frame {
    position: relative;
  }

  /* Full-bleed photo. The copy stacks at the bottom with the credential
     marquee beneath it, so the whole lower band is one left-aligned column. */
  .hero {
    position: relative;
    z-index: 1;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  /* Mirrored so the face sits on the right, clear of the copy on the left */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--hero-image) 35% 30% / cover no-repeat;
    transform: scaleX(-1);
  }

  /* Both washes on one layer, since ::before is carrying the photo now: the
     first darkens the top for the white logo, the second keeps the headline
     readable against a bright sky. */
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(0, 0, 0, 0.35), transparent 220px),
      linear-gradient(
        rgba(10, 30, 45, 0.1) 30%,
        rgba(10, 30, 45, 0.55) 74%,
        rgba(10, 30, 45, 0.72)
      );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    /* Deliberately narrow so the headline wraps into a tight block rather
       than running across the photo */
    max-width: 680px;
    /* Lines the headline up with the logo in the navbar */
    padding: 0 calc(var(--frame) + var(--nav-pad-x)) 11vh;
  }

  .hero h1 {
    margin: 0 0 20px;
    color: #fff;
    font-family: "DM Serif Display", Georgia, serif;
    font-weight: 400;
    font-size: clamp(2.2rem, 4.6vw, 4.2rem);
    line-height: 1.05;
    letter-spacing: 0.005em;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.25);
  }

  /* Narrower than the headline so the block stays a column rather than
     spreading across the photo */
  .hero-copy {
    margin: 0 0 30px;
    max-width: 480px;
    color: rgba(255, 255, 255, 0.9);
    font-family: "Jost", "Poppins", sans-serif;
    font-size: clamp(0.95rem, 1.15vw, 1.08rem);
    line-height: 1.6;
  }

  .hero-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--blue-dark);
    color: #fff;
    text-decoration: none;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 12px 22px;
    border-radius: 8px;
    transition: background 0.2s;
  }

  .hero-button:hover {
    background: var(--blue-deep);
  }

  .hero-button-arrow {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s;
  }

  .hero-button:hover .hero-button-arrow {
    transform: translate(2px, -2px);
  }

  /* Certification ticker — lives at the foot of the hero, over the photo */
  .ticker {
    position: relative;
    z-index: 1;
    padding: 0 0 30px;
    overflow: hidden;
  }

  .ticker-label {
    margin: 0 0 16px;
    /* Same left edge as the headline and the logo */
    padding-left: calc(var(--frame) + var(--nav-pad-x));
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  /* Fades the logos out at both edges instead of clipping them hard */
  .ticker-viewport {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent,
      #000 7%,
      #000 93%,
      transparent
    );
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 7%,
      #000 93%,
      transparent
    );
  }

  .ticker-track {
    display: flex;
    width: max-content;
    animation: ticker-scroll 42s linear infinite;
  }

  .ticker-viewport:hover .ticker-track {
    animation-play-state: paused;
  }

  /* The trailing padding matches the gap so the two copies butt together
     with no visible seam at the loop point. */
  .ticker-group {
    display: flex;
    align-items: center;
    gap: 40px;
    margin: 0;
    padding: 0 40px 0 0;
    list-style: none;
  }

  .ticker-group li {
    display: flex;
  }

  /* Same soft pill on hover as the navbar links */
  .ticker-group a {
    color: rgba(255, 255, 255, 0.88);
    text-decoration: none;
    white-space: nowrap;
    line-height: 1;
    padding: 10px 18px;
    border-radius: 999px;
    transition: background 0.2s;
  }

  .ticker-group a:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  .ticker-group a:focus-visible {
    background: rgba(255, 255, 255, 0.16);
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  /* Placeholder wordmarks: varied faces stand in for real logo files */
  .tk-wide {
    font-family: "Jost", sans-serif;
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: 0.22em;
  }

  .tk-serif {
    font-family: "DM Serif Display", Georgia, serif;
    font-size: 1.45rem;
  }

  .tk-geo {
    font-family: "Jost", sans-serif;
    font-size: 1.5rem;
    font-weight: 400;
  }

  .tk-sans {
    font-family: "Poppins", sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
  }

  @keyframes ticker-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none;
    }

    .ticker-viewport {
      overflow-x: auto;
    }

    .ticker-group[aria-hidden="true"] {
      display: none;
    }
  }

  /* Who We Are */
  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 72px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 120px 40px;
    color: var(--ink);
  }

  /* Small label above a section heading */
  .section-eyebrow {
    margin: 0 0 14px;
    color: var(--blue-dark);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  /* Shared by every section heading so they cannot drift apart */
  .section-heading {
    margin: 0 0 24px;
    color: var(--blue);
    font-family: "DM Serif Display", Georgia, serif;
    font-weight: 400;
    font-size: clamp(2rem, 3.9vw, 3.2rem);
    line-height: 1.08;
  }

  /* Sections are carried by one serif sentence, sized between the heading and
     the body copy so it reads as a statement rather than a paragraph.
     Lora rather than the heading's DM Serif Display: DM Serif ships a single
     thick-stemmed cut that reads bold at text sizes. */
  .section-statement {
    margin: 0 0 26px;
    color: #3d4b55;
    font-family: "Lora", Georgia, serif;
    font-weight: 400;
    /* Sized for a paragraph rather than a single line — the larger setting
       read as a pull quote once there was more than one sentence in it. The
       looser leading keeps the serif comfortable at this size. */
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.65;
  }

  .about .section-statement {
    max-width: 520px;
  }

  /* A supporting line under a heading, rather than a statement in its own
     right: Jost — the same sans as the Learn More links and tour captions —
     at a much smaller size than .section-statement's serif. Shared so the
     dark sections cannot drift apart; colour and spacing stay per-section. */
  .section-subline {
    margin: 0;
    font-family: "Jost", "Poppins", sans-serif;
    font-size: clamp(0.9rem, 1.05vw, 1rem);
    line-height: 1.6;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    padding-bottom: 3px;
    color: var(--blue-dark);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    border-bottom: 1px solid rgba(34, 116, 171, 0.35);
    transition: color 0.2s, border-color 0.2s;
  }

  .text-link:hover {
    color: var(--blue-deep);
    border-color: var(--blue-deep);
  }

  .text-link-arrow {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s;
  }

  .text-link:hover .text-link-arrow {
    transform: translateX(3px);
  }

  /* Arch: an oversized top radius gets clamped by the browser to half the
     element's width, giving a true semicircular top that flows into straight
     sides and a flat bottom edge. Reverts to a rounded rect once stacked. */
  .about-image {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 1000px 1000px 0 0;
  }

  /* PLACEHOLDER: standing in with the hero shot until the real photo lands */
  .about-image-placeholder {
    background: var(--hero-image) center / cover no-repeat;
  }

  /* Treatments */
  .treatments {
    background: var(--band);
    padding: 104px 0;
  }

  .treatments-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .treatments .section-subline {
    max-width: 560px;
    margin-bottom: 56px;
    color: #3d4b55;
  }

  /* Hairlines come from the grid's top border plus a left border per column,
     so the rules meet exactly with no doubled-up lines. */
  .treatment-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hairline);
  }

  .treatment {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 34px 30px 0;
    border-left: 1px solid var(--hairline);
  }

  .treatment:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .treatment:last-child {
    padding-right: 0;
  }

  .treatment-num {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
  }

  .treatment-title {
    margin: 26px 0 12px;
    color: var(--ink);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .treatment-copy {
    margin: 0 0 18px;
    color: #3d4b55;
    font-size: 0.9rem;
    line-height: 1.65;
  }

  /* Short fact fragments, so they read as a spec list rather than prose */
  .treatment-points {
    margin: 0 0 22px;
    padding: 0;
    list-style: none;
  }

  .treatment-points li {
    position: relative;
    padding-left: 15px;
    color: #3d4b55;
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .treatment-points li + li {
    margin-top: 7px;
  }

  .treatment-points li::before {
    content: "";
    position: absolute;
    top: 0.58em;
    left: 0;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--blue-dark);
  }

  /* Pins every Learn More to the same baseline despite uneven copy lengths */
  .treatment .text-link {
    margin-top: auto;
  }

  /* Office tour */
  .tour {
    background: #fff;
    padding: 104px 0;
  }

  .tour-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .tour-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }

  .tour .section-heading {
    margin: 0;
  }

  /* Keeps the heading and its subline together on the left, so space-between
     still pushes the CTA to the right edge */
  .tour-headings {
    min-width: 0;
  }

  .tour .section-subline {
    margin-top: 10px;
    color: #3d4b55;
  }

  .tour-cta {
    flex-shrink: 0;
    padding: 15px 28px;
    border: 1px solid var(--blue-dark);
    border-radius: 8px;
    background: transparent;
    color: var(--blue-dark);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: background 0.2s, color 0.2s;
  }

  .tour-cta:hover {
    background: var(--blue-dark);
    color: #fff;
  }

  /* Each room is one full photo card, with its neighbours peeking in at the
     sides. Built on scroll-snap rather than transforms, so it swipes natively
     on touch and still works if the script never runs. */
  .tour-carousel {
    position: relative;
    margin-top: 48px;
    /* Sized so the centred card lines up with the page container while its
       neighbours run off both edges of the screen */
    --tour-side: max(20px, calc((100% - 1120px) / 2));
  }

  .tour-track {
    display: flex;
    gap: 20px;
    margin: 0;
    padding: 0 var(--tour-side);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .tour-track::-webkit-scrollbar {
    display: none;
  }

  .tour-slide {
    position: relative;
    flex: 0 0 100%;
    height: clamp(360px, 46vw, 560px);
    scroll-snap-align: center;
    border-radius: 4px;
    overflow: hidden;
    /* PLACEHOLDER: every card is the hero shot until the real photos arrive */
    background: var(--hero-image) center / cover no-repeat;
  }

  /* The copy sits at the top of the card now, so the scrim runs the other way */
  .tour-slide::after {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 68%;
    /* Holds most of its weight through the text block before falling away, so
       the copy stays readable over a pale photo as well as a dark one */
    background: linear-gradient(
      rgba(6, 14, 20, 0.86) 0%,
      rgba(6, 14, 20, 0.66) 38%,
      rgba(6, 14, 20, 0) 100%
    );
  }

  .tour-slide-text {
    position: absolute;
    inset: 34px 34px auto;
    z-index: 1;
  }

  .tour-room {
    margin: 0;
    color: #fff;
    font-family: "Jost", "Poppins", sans-serif;
    font-weight: 500;
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    line-height: 1.15;
  }

  .tour-blurb {
    margin: 10px 0 0;
    max-width: 34ch;
    color: #fff;
    font-family: "Jost", "Poppins", sans-serif;
    font-size: clamp(0.9rem, 1.05vw, 1rem);
    line-height: 1.55;
  }

  /* Centred on the card's edge, the way the reference sits them */
  .tour-arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    padding: 0;
    transform: translateY(-50%);
    border: 1px solid var(--hairline);
    border-radius: 50%;
    background: #fff;
    color: var(--ink);
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .tour-arrow:hover {
    background: var(--ink);
    color: #fff;
  }

  .tour-arrow-prev {
    left: calc(var(--tour-side) - 23px);
  }

  .tour-arrow-next {
    right: calc(var(--tour-side) - 23px);
  }

  .tour-arrow svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tour-dots {
    position: absolute;
    right: 0;
    bottom: 22px;
    left: 0;
    z-index: 2;
    display: flex;
    justify-content: center;
    gap: 9px;
  }

  .tour-dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    /* The ring keeps the dots legible over a pale photo as well as a dark one */
    background: rgba(255, 255, 255, 0.5);
    box-shadow: 0 0 0 1px rgba(6, 14, 20, 0.25);
    cursor: pointer;
    transition: background 0.2s;
  }

  .tour-dot.is-active {
    background: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .tour-track {
      scroll-behavior: auto;
    }
  }

  /* Locations */
  .locations {
    background: #fff;
    padding: 104px 0;
  }

  .locations-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .locations-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    margin-bottom: 20px;
  }

  .locations .section-heading {
    margin: 0;
  }

  .locations-tagline {
    flex-shrink: 0;
    margin: 0;
    color: var(--muted);
    font-family: "Jost", "Poppins", sans-serif;
    font-size: clamp(0.9rem, 1.05vw, 1rem);
    line-height: 1.5;
  }

  /* With a single office this is a label, not a tab — so it is not a button */
  .location-pill {
    display: inline-block;
    margin: 0 0 24px;
    padding: 11px 22px;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    background: var(--band);
    color: var(--ink);
    font-size: 0.95rem;
  }

  .location-card {
    display: flex;
    gap: 0;
    border-radius: 16px;
    background: var(--band);
    overflow: hidden;
  }

  /* Positioned so the iframe can fill it: a percentage height needs a parent
     with a definite one, which a stretched flex item does not give it */
  .location-map {
    position: relative;
    flex: 0 0 42%;
    min-height: 420px;
    background: #e8eef2;
  }

  /* Lenis ships a stylesheet that kills pointer events on every iframe so they
     cannot swallow the wheel. We do not load it — nothing else in it applies
     here, and a map you cannot pan is worth less than the scroll-trap costs —
     so this keeps the map usable if that sheet is ever added back. */
  .lenis.lenis-smooth .location-map iframe {
    pointer-events: auto;
  }

  .location-map iframe {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .location-body {
    display: flex;
    flex: 1 1 0;
    min-width: 0;
    flex-direction: column;
    padding: 34px 36px;
  }

  .location-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }

  .location-name {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .location-city {
    margin: 4px 0 0;
    color: var(--ink);
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    font-weight: 600;
    line-height: 1.2;
  }

  .location-directions {
    flex-shrink: 0;
    padding: 13px 22px;
    border: 1px solid var(--hairline);
    border-radius: 8px;
    background: #fff;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }

  .location-directions:hover {
    border-color: var(--ink);
    background: var(--ink);
    color: #fff;
  }

  .location-details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
    margin-top: 34px;
  }

  .location-label {
    margin: 0 0 10px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .location-value {
    margin: 0;
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.65;
  }

  .location-value a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }

  .location-value a:hover {
    border-bottom-color: var(--ink);
  }

  /* Pushed to the bottom so the row sits on the card's baseline */
  .location-footer {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: auto;
    padding-top: 26px;
    border-top: 1px solid var(--hairline);
  }

  .location-today {
    margin: 0 auto 0 0;
    color: var(--ink);
    font-size: 0.95rem;
  }

  .location-hours {
    position: relative;
  }

  .location-hours summary {
    color: var(--muted);
    font-size: 0.95rem;
    cursor: pointer;
    list-style: none;
  }

  .location-hours summary::-webkit-details-marker {
    display: none;
  }

  .location-hours summary:hover {
    color: var(--ink);
  }

  /* Floated above the link rather than pushed into the row: in the stacked
     layout a flex-basis would size the height, not the width, and the list
     would spill out of the card */
  .location-hours ul {
    position: absolute;
    right: 0;
    bottom: calc(100% + 12px);
    z-index: 2;
    width: max-content;
    max-width: 78vw;
    margin: 0;
    padding: 14px 18px;
    border: 1px solid var(--hairline);
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 10px 30px rgba(22, 35, 44, 0.12);
    list-style: none;
  }

  .location-hours li {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    padding: 5px 0;
    color: var(--ink);
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .location-hours-days {
    color: var(--muted);
  }

  .location-hours-time em {
    margin-left: 7px;
    color: var(--muted);
    font-size: 0.82rem;
    font-style: normal;
  }

  .location-disclaimer {
    flex-shrink: 0;
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  /* FAQ */
  .faq {
    background: var(--band);
    padding: 104px 0;
  }

  .faq-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 64px;
  }

  /* Top-aligned rather than stretched to the list's height. Not sticky: the
     FAQ is the last section and shorter than a typical viewport, so there is
     never anything for it to stick against. */
  .faq-intro {
    align-self: start;
  }

  .faq-intro .section-heading {
    margin-bottom: 18px;
  }

  .faq-intro .section-subline {
    max-width: 330px;
    color: #3d4b55;
  }

  .faq-item {
    border-top: 1px solid var(--hairline);
  }

  .faq-item:last-child {
    border-bottom: 1px solid var(--hairline);
  }

  .faq-item summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding: 22px 0;
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  /* DM Serif Display is the heavy serif in the system. Its single cut IS the
     heavy one, so the weight stays at 400 — asking for 600 here would make the
     browser smear a fake bold over an already-thick face. */
  .faq-question {
    color: var(--ink);
    font-family: "DM Serif Display", Georgia, serif;
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.4;
    transition: color 0.2s;
  }

  .faq-item summary:hover .faq-question {
    color: var(--blue-dark);
  }

  .faq-item summary:focus-visible {
    outline: 2px solid var(--blue-dark);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .faq-icon {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    margin-top: 4px;
    fill: none;
    stroke: var(--blue-dark);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.25s ease;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
  }

  .faq-answer {
    margin: 0;
    padding: 0 40px 24px 0;
    color: #3d4b55;
    font-size: 0.92rem;
    line-height: 1.7;
  }

  /* Native <details> snaps open. Where the browser can animate to a keyword
     size it slides instead; everywhere else it just opens. */
  @supports (interpolate-size: allow-keywords) {
    .faq-list {
      interpolate-size: allow-keywords;
    }

    .faq-item::details-content {
      block-size: 0;
      overflow: hidden;
      transition: block-size 0.28s ease, content-visibility 0.28s allow-discrete;
    }

    .faq-item[open]::details-content {
      block-size: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-icon,
    .faq-item::details-content {
      transition: none;
    }
  }

  /* Closing call to action */
  /* Padded top and bottom so the card floats in white rather than butting
     against the grey FAQ band above it */
  .consult {
    background: #fff;
    padding: 104px 0;
  }

  .consult-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* The one dark surface left on the page, so the last thing you scroll to
     reads as the close rather than another band of content */
  .consult-card {
    padding: 92px 40px;
    border-radius: 16px;
    background: var(--ink);
    text-align: center;
  }

  .consult-heading {
    margin: 0 0 18px;
    color: #fff;
    font-family: "DM Serif Display", Georgia, serif;
    font-weight: 400;
    font-size: clamp(1.9rem, 3.4vw, 2.9rem);
    line-height: 1.12;
  }

  .consult-copy {
    margin: 0 auto 32px;
    max-width: 520px;
    color: rgba(255, 255, 255, 0.78);
    font-family: "Jost", "Poppins", sans-serif;
    font-size: clamp(0.9rem, 1.05vw, 1rem);
    line-height: 1.65;
  }

  .consult-button {
    display: inline-block;
    padding: 14px 26px;
    border-radius: 8px;
    background: var(--blue-dark);
    color: #fff;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    transition: background 0.2s;
  }

  .consult-button:hover {
    background: var(--blue-deep);
  }

  .consult-button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  /* Footer */
  .footer {
    background: var(--band);
    border-top: 1px solid var(--hairline);
    padding: 76px 0 0;
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 60px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px 64px;
  }

  /* The mark is white in the navbar, so the footer paints it back to ink */
  .footer .logo {
    color: var(--ink);
  }

  .footer .logo-mark {
    width: 46px;
    fill: var(--ink);
  }

  .footer .logo-wire {
    stroke: var(--ink);
  }

  .footer-blurb {
    margin: 22px 0 18px;
    max-width: 280px;
    color: #3d4b55;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .footer-address {
    color: var(--muted);
    font-size: 0.88rem;
    font-style: normal;
    line-height: 1.85;
  }

  .footer-address a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-address a:hover {
    color: var(--blue-dark);
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }

  .footer-group-title {
    margin: 0 0 16px;
    color: var(--blue-dark);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer-group ul,
  .footer-legal {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-group li + li {
    margin-top: 10px;
  }

  .footer-group a {
    color: #3d4b55;
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }

  .footer-group a:hover {
    color: var(--blue-dark);
  }

  .footer-base {
    max-width: 1200px;
    margin: 0 auto;
    padding: 22px 40px 26px;
    border-top: 1px solid var(--hairline);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .footer-copyright {
    margin: 0;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
  }

  .footer-legal a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.82rem;
    transition: color 0.2s;
  }

  .footer-legal a:hover {
    color: var(--blue-dark);
  }

  /* Testimonials */
  .testimonials {
    background: var(--band);
    padding: 120px 0;
  }

  .testimonials-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* A little more air than the default, since the quote below it is large */
  .testimonials .section-eyebrow {
    margin-bottom: 26px;
  }

  /* Every slide occupies the same grid cell, so the track keeps the height of
     the tallest review and the bars below never jump between rotations */
  .testimonial-track {
    display: grid;
  }

  .testimonial {
    grid-area: 1 / 1;
    margin: 0;
    opacity: 0;
    /* visibility also takes inactive slides out of the accessibility tree */
    visibility: hidden;
    transition: opacity 0.5s ease, visibility 0.5s;
  }

  .testimonial.is-active {
    opacity: 1;
    visibility: visible;
  }

  /* Lora rather than the heading serif: at this size DM Serif reads as bold */
  /* Sized as a quote rather than a heading: at the old 2.9rem it matched the
     section headings, so a patient's sentence carried the same weight as the
     site's own voice. The measure is capped too, or the smaller type would
     run past 80 characters a line across the full container. */
  .testimonial-quote {
    margin: 0 0 40px;
    max-width: 820px;
    color: var(--ink);
    font-family: "Lora", Georgia, serif;
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    line-height: 1.5;
    /* Hangs the opening quote mark into the margin so the first line of text
       still lines up flush left with everything below it */
    text-indent: -0.42em;
  }

  .testimonial-author {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .testimonial-avatar {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--blue-dark);
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .testimonial-meta {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .testimonial-name {
    color: var(--ink);
    font-size: 1rem;
    font-weight: 600;
  }

  .testimonial-stars {
    display: flex;
    gap: 2px;
  }

  .testimonial-star {
    width: 15px;
    height: 15px;
    fill: #f4b400;
  }

  .testimonial-source {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .testimonial-bars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    gap: 14px;
    margin-top: 64px;
  }

  /* The button is 24px tall for a usable target; the visible rule is 2px */
  .testimonial-bar {
    position: relative;
    height: 24px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .testimonial-bar::before {
    content: "";
    position: absolute;
    inset: calc(50% - 1px) 0 auto;
    height: 2px;
    background: rgba(22, 35, 44, 0.15);
  }

  .testimonial-bar-fill {
    position: absolute;
    inset: calc(50% - 1px) auto auto 0;
    height: 2px;
    width: 0;
    background: var(--ink);
    /* Only used when the bars reset at wrap-around; the running animation
       takes over the width while a bar is active */
    transition: width 0.35s ease;
  }

  /* Bars already passed stay lit, so the row reads as progress through the set */
  .testimonial-bar.is-filled .testimonial-bar-fill {
    width: 100%;
  }

  .testimonial-bar.is-active .testimonial-bar-fill {
    animation: testimonial-bar-fill 7s linear forwards;
  }

  @keyframes testimonial-bar-fill {
    to {
      width: 100%;
    }
  }

  .testimonial-bar:focus-visible {
    outline: 2px solid var(--blue-dark);
    outline-offset: 3px;
  }

  /* No animation means no animationend, so rotation stops and the bars become
     plain manual controls */
  @media (prefers-reduced-motion: reduce) {
    .testimonial {
      transition: none;
    }

    .testimonial-bar.is-active .testimonial-bar-fill {
      animation: none;
      width: 100%;
    }
  }

  /* Tablet: links move into a full-screen menu behind a round toggle */
  @media (max-width: 1024px) {
    :root {
      --nav-pad-y: 16px;
      --nav-pad-x: 18px;
    }

    .navbar {
      display: flex;
    }

    .nav-links {
      position: fixed;
      inset: 0;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 20px;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: rgba(20, 30, 38, 0.96);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.25s, visibility 0.25s;
    }

    .nav-links a {
      color: #fff;
      font-size: 1.15rem;
    }

    .nav-links a:hover {
      background: rgba(255, 255, 255, 0.1);
    }

    .nav-links.open {
      opacity: 1;
      visibility: visible;
    }

    .nav-toggle {
      display: flex;
      position: relative;
      z-index: 1;
    }

    .nav-toggle[aria-expanded="true"] span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .nav-toggle[aria-expanded="true"] span:nth-child(2) {
      opacity: 0;
    }

    .nav-toggle[aria-expanded="true"] span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    .logo {
      margin-right: auto;
    }

    .nav-actions {
      margin-right: 10px;
    }

    /* Two columns: the odd cards start a row, so they lose the left rule */
    .treatment-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .treatment:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }

    .treatment:nth-child(even) {
      padding-right: 0;
    }

    .treatment:nth-child(n + 3) {
      margin-top: 34px;
      border-top: 1px solid var(--hairline);
    }
  }

  @media (max-width: 900px) {
    .tour {
      padding: 72px 0;
    }

    .tour-inner {
      padding: 0 20px;
    }

    .tour-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }

    .tour-carousel {
      margin-top: 32px;
      --tour-side: 16px;
    }

    .tour-slide {
      height: 320px;
    }

    .tour-slide-text {
      inset: 24px 24px auto;
    }

    /* Swiping replaces the arrows once the card is this narrow */
    .tour-arrow {
      display: none;
    }
  }

  /* The navbar runs out of room here before anything else does */
  @media (max-width: 1150px) {
    .nav-phone-number {
      display: none;
    }
  }

  /* Phone: tighter navbar inset, icons dropped so the button fits */
  @media (max-width: 600px) {
    :root {
      --frame: 10px;
    }

    :root {
      --nav-pad-y: 10px;
      --nav-pad-x: 14px;
    }

    .logo {
      gap: 8px;
    }

    .logo-mark {
      width: 36px;
    }

    .logo-top {
      font-size: 0.5rem;
      margin-bottom: 3px;
    }

    .logo-name {
      font-size: 1.1rem;
    }

    .nav-icon,
    .nav-phone {
      display: none;
    }

    .nav-actions {
      padding: 4px;
    }

    .nav-button {
      font-size: 0.78rem;
      padding: 8px 16px;
    }

    /* Smaller wordmarks so more than one credential is on screen at a time */
    .ticker {
      padding: 34px 0 38px;
    }

    .ticker-label {
      margin-bottom: 22px;
    }

    .ticker-group {
      gap: 24px;
      padding-right: 24px;
    }

    .ticker-group a {
      padding: 8px 12px;
    }

    .tk-wide {
      font-size: 1.05rem;
      letter-spacing: 0.18em;
    }

    .tk-serif {
      font-size: 1.1rem;
    }

    .tk-geo {
      font-size: 1.15rem;
    }

    .tk-sans {
      font-size: 0.95rem;
    }

    .about {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 72px 20px;
    }

    .about-image {
      aspect-ratio: 4 / 3;
      border-radius: 22px;
    }

    .treatments {
      padding: 72px 0;
    }

    .treatments-inner,
    .testimonials-inner {
      padding: 0 20px;
    }

    .locations {
      padding: 72px 0;
    }

    .locations-inner {
      padding: 0 20px;
    }

    .location-card {
      flex-direction: column;
    }

    .location-map {
      flex: none;
      min-height: 260px;
    }

    .location-body {
      padding: 26px 22px;
    }

    .locations-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .location-head {
      flex-direction: column;
      gap: 18px;
    }

    .location-details {
      grid-template-columns: 1fr;
      gap: 22px;
